[Unit]
Description=YRM Panel - Linux Server Management
After=network.target docker.service smbd.service
Wants=network.target

[Service]
Type=simple
User=@PANEL_USER@
Group=@PANEL_GROUP@
WorkingDirectory=/opt/yrm-panel
EnvironmentFile=/etc/yrm-panel/panel.env
ExecStart=/opt/yrm-panel/YrmPanel
Restart=on-failure
RestartSec=5
UMask=0007
# The host's ordinary Linux user runs the web application; it never runs as root.
# The sudoers file only grants specific root-owned helpers after password entry.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
# Password-verified Samba helpers inherit this service mount namespace.
# Permit only Samba configuration writes, not a writable /etc.
ReadWritePaths=/var/lib/yrm-panel /etc/samba
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
