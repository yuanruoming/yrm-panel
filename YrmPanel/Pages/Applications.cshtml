@page
@model YrmPanel.Pages.ApplicationsModel
@{ ViewData["Title"] = "Applications"; }
<div class="page-heading"><div><p class="eyebrow">YOUR WORKSPACE</p><h1>Applications<span class="accent-period">.</span></h1></div><a class="button button-primary" asp-page="/Settings">+ Add shortcut</a></div>
@if (Model.Shortcuts.Count > 0) {
<section class="surface-card app-section"><div class="card-header"><div><p class="eyebrow">SHORTCUTS</p><h3>Quick links</h3></div></div>
<div class="shortcut-grid">@foreach (var link in Model.Shortcuts) { <a class="shortcut-tile" href="@link.Url" target="_blank" rel="noopener noreferrer"><span class="shortcut-symbol">↗</span><span>@link.Name</span></a> }</div>
</section>
}
<section class="surface-card app-section"><div class="card-header"><div><p class="eyebrow">AUTO DISCOVERY</p><h3>Docker Compose projects</h3></div><a class="text-link" asp-page="/Docker">All containers ↗</a></div>
@if (!Model.Docker.Available) { <div class="empty-hint">Docker is not connected.<small>@Model.Docker.Error</small></div> }
else if (Model.Docker.Containers.Count == 0) { <div class="empty-hint compact-empty">No containers yet.</div> }
else {
    <div class="application-grid">
    @foreach (var group in Model.Docker.Containers.GroupBy(x => string.IsNullOrWhiteSpace(x.Project) ? x.Name : x.Project).OrderBy(x => x.Key))
    {
        var running = group.Count(x => x.State == "running");
        var isNginx = group.Any(x => x.Image.Contains("nginx", StringComparison.OrdinalIgnoreCase));
        <div class="app-card"><div class="app-icon @(isNginx ? "nginx-app-icon" : "")">
            @if (isNginx) { <strong class="app-logo-letter">N</strong> }
            else { <svg class="ui-icon"><use href="#i-docker-symbol"/></svg> }
        </div><div class="app-info"><strong>@group.Key</strong><small>@running / @group.Count() running</small></div><span class="status-circle @(running == group.Count() ? "on" : "off")"></span></div>
    }
    </div>
}
</section>
