@page
@model YrmPanel.Pages.ApplicationsModel
@{ ViewData["Title"] = "Applications";
   var groups = Model.Docker.Containers.GroupBy(c => string.IsNullOrWhiteSpace(c.Project) ? c.Name : c.Project)
      .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase).ToArray(); }
<div class="yrm-app-actions"><button class="button button-primary" type="button" data-open-add-app>+ Add App</button></div>
@if (!string.IsNullOrWhiteSpace(Model.Notice)) { <div class="notice" data-result-notice="@(Model.Notice.StartsWith("Error:") ? "error" : "success")">@Model.Notice</div> }
@if (!Model.Docker.Available) { <p class="muted">Docker unavailable: @Model.Docker.Error</p> }
<div class="unified-app-grid">
    @for (int i = 0; i < Model.Shortcuts.Count; i++)
    {
        var app = Model.Shortcuts[i]; var id = "link:" + i; var isPinned = Model.Pinned.Contains(id);
        <div class="unified-app-card">
            <form method="post" asp-page-handler="Pin" class="app-pin-form"><input type="hidden" name="id" value="@id"/><input type="hidden" name="pinned" value="@(!isPinned ? "true" : "false")"/>
                <button class="app-pin-button @(isPinned ? "is-pinned" : "")" type="submit" title="@(isPinned ? "Unpin from desktop" : "Pin to desktop")" aria-label="@(isPinned ? "Unpin" : "Pin")"><svg class="ui-icon"><use href="@(isPinned ? "#i-pin-off" : "#i-pin")"/></svg></button></form>
            <a class="unified-app-main" href="@app.Url" target="_blank" rel="noopener noreferrer">
                <span class="unified-app-visual app-manual"><svg class="ui-icon"><use href="#i-globe"/></svg></span>
                <strong>@app.Name</strong><small>Open app ↗</small>
            </a>
            <button class="unified-app-edit" type="button" data-edit-app-index="@i" data-edit-app-name="@app.Name" data-edit-app-url="@app.Url" title="Edit application">Edit</button>
        </div>
    }
    @if (Model.Docker.Available)
    {
      @foreach (var group in groups)
      {
        var id = "docker:" + group.Key; var isPinned = Model.Pinned.Contains(id);
        var running = group.Count(c => c.State == "running");
        var label = group.Key;
        var image = string.Join(" ", group.Select(c => c.Image)).ToLowerInvariant();
        var brand = image.Contains("nginx") ? "N" : image.Contains("redis") ? "R" : image.Contains("postgres") ? "P" : image.Contains("mariadb") ? "M" : image.Contains("nextcloud") ? "N" : "";
        <div class="unified-app-card">
            <form method="post" asp-page-handler="Pin" class="app-pin-form"><input type="hidden" name="id" value="@id"/><input type="hidden" name="pinned" value="@(!isPinned ? "true" : "false")"/>
                <button class="app-pin-button @(isPinned ? "is-pinned" : "")" type="submit" title="@(isPinned ? "Unpin from desktop" : "Pin to desktop")"><svg class="ui-icon"><use href="@(isPinned ? "#i-pin-off" : "#i-pin")"/></svg></button></form>
            <a class="unified-app-main" asp-page="/Docker">
                <span class="unified-app-visual app-container">@if (brand.Length > 0) { <b>@brand</b> } else { <svg class="ui-icon"><use href="#i-docker-symbol"/></svg> }</span>
                <strong>@label</strong><small>@running / @group.Count() running</small>
            </a>
            <span class="status-circle @(running == group.Count() ? "on" : "off")" title="Docker status"></span>
        </div>
      }
    }
    @if (Model.Shortcuts.Count == 0 && groups.Length == 0)
    { <div class="unified-empty">No applications.</div> }
</div>
<dialog id="application-editor-dialog" class="panel-modal" aria-labelledby="application-editor-title">
    <div class="panel-modal-head"><strong id="application-editor-title">Add app</strong><button type="button" data-close-dialog="application-editor-dialog">×</button></div>
    <form method="post" asp-page-handler="Save" id="application-editor-form" class="form-stack">
        <input type="hidden" name="index" value="-1" id="application-editor-index"/>
        <label>App name<input name="name" id="application-editor-name" required maxlength="40" autocomplete="off"/></label>
        <label>Web address<input name="url" id="application-editor-url" type="url" required maxlength="2000" placeholder="http://192.168.0.10:8080"/></label>
        <div class="panel-modal-actions"><button type="button" class="button button-secondary" data-close-dialog="application-editor-dialog">Cancel</button><button class="button button-primary" type="submit">Save</button></div>
    </form>
    <form method="post" asp-page-handler="Delete" id="application-delete-form" data-confirm="Remove this shortcut?" hidden>
        <input type="hidden" name="index" id="application-delete-index"/><button class="button danger" type="submit">Remove shortcut</button>
    </form>
</dialog>
