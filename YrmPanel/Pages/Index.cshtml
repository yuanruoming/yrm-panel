@page
@model YrmPanel.Pages.IndexModel
@{
    ViewData["Title"] = "Desktop";
}
@if (TempData["PowerMessage"] is string powerMessage)
{ <div class="desktop-power-notice" data-result-notice="@(powerMessage.StartsWith("Error:") ? "error" : "success")">@powerMessage</div> }
<div class="desktop-safe-space" aria-label="Your desktop wallpaper"></div>


@inject YrmPanel.Services.PanelSettingsStore DesktopSettings
@{ var desktop = DesktopSettings.Read(); }
@if (desktop.PinnedApps.Count > 0)
{
<div class="desktop-pins" aria-label="Pinned desktop applications">
@foreach (var id in desktop.PinnedApps)
{
    if (id.StartsWith("link:") && int.TryParse(id[5..], out var idx) && idx >= 0 && idx < desktop.Shortcuts.Count)
    {
        <a href="@desktop.Shortcuts[idx].Url" target="_blank" rel="noopener noreferrer" class="desktop-pin"><span class="desktop-pin-icon"><svg class="ui-icon"><use href="#i-arrow" /></svg></span><span>@desktop.Shortcuts[idx].Name</span></a>
    }
    else
    {
        var name = id.StartsWith("docker:", StringComparison.Ordinal) ? id[7..] : id switch { "/Applications" => "Apps", "/Docker" => "Docker", "/Services" => "Services", "/Files" => "Files", "/Shares" => "File Sharing", "/Settings" => "Settings", _ => null };
        if (name is not null)
        {
            var icon = id.StartsWith("docker:", StringComparison.Ordinal) ? "i-docker-symbol" : id switch { "/Docker" => "i-docker-symbol", "/Files" => "i-folder", "/Shares" => "i-globe", "/Services" => "i-server", "/Settings" => "i-settings", _ => "i-grid" };
            <a href="@(id.StartsWith("docker:", StringComparison.Ordinal) ? "/Docker" : id)" class="desktop-pin"><span class="desktop-pin-icon"><svg class="ui-icon"><use href="@("#" + icon)" /></svg></span><span>@name</span></a>
        }
    }
}
</div>
}
