@page
@model YrmPanel.Pages.IndexModel
@{
    ViewData["Title"] = "Desktop";
}
@if (TempData["PowerMessage"] is string powerMessage)
{ <div class="desktop-power-notice" data-result-notice="@(powerMessage.StartsWith("Error:") ? "error" : "success")">@powerMessage</div> }
<div class="desktop-safe-space" aria-label="Your desktop wallpaper"></div>
