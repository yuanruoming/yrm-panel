@page
@model YrmPanel.Pages.Account.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>YRM PANEL</title>
    <link rel="stylesheet" asp-append-version="true" href="~/css/panel.css" />
    <link rel="stylesheet" asp-append-version="true" href="~/css/desktop.css" />
    <link rel="stylesheet" asp-append-version="true" href="~/css/v1.css" />
    <link rel="stylesheet" asp-append-version="true" href="~/css/v1-stability.css" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <script asp-append-version="true" src="~/js/login-url.js" defer></script>
</head>
<body class="login-body-v2 login-rc4">
    <div class="login-rc4-ambient" aria-hidden="true"></div>
    <div class="login-topbrand"><img src="~/images/yrm-panel-mark.png" class="yrm-brand-icon" width="35" height="35" alt="YRM PANEL logo" /><strong>YRM <span>Panel</span></strong></div>
    <main class="login-stage">
        <section class="login-glass" aria-labelledby="sign-in-heading">
            <div class="login-smalltitle">YOUR SERVER · YOUR CONTROL</div>
            <h1 id="sign-in-heading">Welcome back.</h1>
            <p>Sign in using your @Model.AccountDescription.</p>
            @if (!string.IsNullOrEmpty(Model.Error))
            { <div class="notice error" role="alert">@Model.Error</div> }
            <form method="post" action="/Account/Login" asp-antiforgery="true" class="login-form-v2">
                <label for="username">Username</label>
                <input id="username" name="Username" value="@Model.Username" autocomplete="username" maxlength="32" required autofocus />
                <label for="password">Password</label>
                <input id="password" name="Password" type="password" autocomplete="current-password" required />
                <label class="yrm-remember"><input type="checkbox" name="RememberMe" value="true" checked="@Model.RememberMe" />
                  <input type="hidden" name="RememberMe" value="false" /> Keep me signed in</label>
                <button type="submit" class="button button-primary login-submit">Sign in <span aria-hidden="true">→</span></button>
            </form>
            <div class="login-glass-foot"><span class="status-light"></span><span>Private system management</span></div>
        </section>
    </main>
    <div class="login-bottombrand">YRM PANEL <span>·</span> Linux System Management</div>
</body>
</html>
