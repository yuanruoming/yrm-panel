@page
@model YrmPanel.Pages.FilesModel
@using YrmPanel.Services
@inject YrmPanel.Services.FileManagerService FileAccess
@{
    ViewData["Title"] = "Files";
    var shared = Model.Samba.Shares;
    var currentRoute = Model.IsMyFolders ? "@folders" : (string.IsNullOrEmpty(Model.Path) ? "/" : Model.Path);
}
@if (!string.IsNullOrWhiteSpace(Model.Notice))
{ <div class="notice" data-result-notice="@(Model.Notice.StartsWith("Error:") ? "error" : "success")">@Model.Notice</div> }
<section class="fm-explorer yrm-flat-files" data-files-current-path="@currentRoute">
  <div class="fm-columns">
    <aside class="fm-locations" aria-label="File locations">
      <div class="fm-my-files-header">
        <a class="fm-location-link fm-my-files-toggle fm-my-files-home @(Model.IsMyFolders ? "is-active" : "")"
           asp-page="/Files" asp-route-path="@@folders" data-my-files-toggle
           aria-controls="yrm-my-files-children" aria-expanded="false"
           title="Click to expand or collapse; double-click to open My Files">
          <svg class="ui-icon fm-my-files-folder" aria-hidden="true"><use href="#i-folder"/></svg><span>My Files</span>
        </a>
      </div>
      <div class="fm-my-files-children" id="yrm-my-files-children" hidden>
      @foreach (var folderPath in Model.MyFiles)
      {
        var relative = folderPath.TrimStart('/');
        var displayName = System.IO.Path.GetFileName(folderPath);
        <a class="fm-location-link fm-location-child @(Model.Path == relative && (Model.HttpContext.Request.Query["nav"] == "library") ? "is-active" : "")"
           asp-page="/Files" asp-route-path="@relative" asp-route-nav="library">
          <svg class="ui-icon"><use href="#i-folder"/></svg><span>@displayName</span>
        </a>
      }
      </div>
      <div class="yrm-b10-nav-divider"></div>
      <div class="fm-locations-heading yrm-b10-quick-label">QUICK ACCESS</div>
      <div class="yrm-b10-quick-links">
        @foreach (var pinnedPath in Model.QuickAccess)
        {
          var relative = pinnedPath.TrimStart('/');
          <div class="yrm-b10-quick-item yrm-b11-quick-item">
            <a class="fm-location-link @(Model.Path == relative && (Model.HttpContext.Request.Query["nav"] == "quick") ? "is-active" : "")" asp-page="/Files" asp-route-path="@relative" asp-route-nav="quick" title="@pinnedPath">
              <svg class="ui-icon"><use href="#i-folder"/></svg><span>@System.IO.Path.GetFileName(pinnedPath)</span>
            </a>
            <details class="explorer-item-menu yrm-b11-quick-menu">
              <summary aria-label="Quick Access actions for @System.IO.Path.GetFileName(pinnedPath)" title="More actions">⋯</summary>
              <div class="explorer-actions-popover">
                <a asp-page="/Files" asp-route-path="@relative">Open</a>
                <form method="post" asp-page-handler="UnpinFolder" asp-route-path="@currentRoute"><input type="hidden" name="folderPath" value="@pinnedPath"/><button type="submit">Unpin from Quick Access</button></form>
              </div>
            </details>
          </div>
        }
        @if (Model.QuickAccess.Count == 0) { <small class="muted yrm-b10-quick-empty">Pin folders from More.</small> }
      </div>
      <details class="fm-system-nav fm-storage-nav" data-persist-disclosure="yrm-panel:files-storage-open">
        <summary><svg class="ui-icon"><use href="#i-harddrive"/></svg> Storage</summary>
        @foreach (var volume in Model.MountedVolumes)
        {
          <a class="fm-location-link" asp-page="/Files" asp-route-path="@volume.MountPoint.TrimStart('/')" title="@volume.MountPoint">
            <svg class="ui-icon"><use href="#i-harddrive"/></svg><span>@Model.StorageLabel(volume)</span>
          </a>
        }
      </details>
      <details class="fm-system-nav" data-persist-disclosure="yrm-panel:system-files-open">
        <summary><svg class="ui-icon"><use href="#i-harddrive"/></svg> System Files</summary>
        <a class="fm-location-link @(!Model.IsMyFolders && Model.Path == "" ? "is-active" : "")"
           asp-page="/Files" asp-route-path="/">Root /</a>
        @if (OperatingSystem.IsLinux() && !string.IsNullOrWhiteSpace(Model.HomePath))
        {
          <a class="fm-location-link @(!Model.IsMyFolders && Model.Path == Model.HomePath ? "is-active" : "")"
             asp-page="/Files" asp-route-path="@Model.HomePath">Linux Home</a>
        }
      </details>
    </aside>
    <div class="fm-content">
      <div class="explorer-path-row fm-unified-path" aria-label="File location">
        <button class="mini-button fm-history-back" type="button" data-fm-history-back title="Back to the previous folder" aria-label="Back">
          <svg class="ui-icon" aria-hidden="true"><use href="#i-arrow-left"/></svg>
        </button>
        <a class="mini-button fm-history-refresh" asp-page="/Files" asp-route-path="@currentRoute" asp-route-hidden="@Model.Hidden" title="Refresh this folder" aria-label="Refresh">
          <svg class="ui-icon" aria-hidden="true"><use href="#i-refresh"/></svg>
        </a>
        <nav class="fm-breadcrumbs" aria-label="Folder breadcrumb">
          @foreach (var crumb in Model.Breadcrumbs)
          {
            @if (crumb != Model.Breadcrumbs.First())
            { <svg class="ui-icon fm-crumb-chevron" aria-hidden="true"><use href="#i-chevron"/></svg> }
            <a asp-page="/Files" asp-route-path="@crumb.Route" asp-route-hidden="@Model.Hidden">@crumb.Label</a>
          }
        </nav>
      </div>
        <div class="explorer-toolbar fm-compact-toolbar">
          <button type="button" class="button button-secondary" data-open-new-folder>＋ New Folder</button>
          @if (!Model.IsMyFolders && Model.View.Available && Model.View.CanWrite)
          {
            <form method="post" asp-page-handler="Upload" asp-route-path="@currentRoute" enctype="multipart/form-data" class="explorer-upload fm-upload-form">
              <input name="upload" id="fm-upload-file" type="file" class="fm-visually-hidden" multiple required />
              <button type="button" class="button button-secondary" data-file-picker="fm-upload-file">Upload</button>
              
              <span id="fm-upload-progress" class="fm-upload-progress" aria-live="polite" hidden></span>
            </form>
          }
          @if (Model.IsMyFolders)
          {
            <button type="button" class="button button-secondary" data-root-upload-open>Upload</button>
          }
          @if (!Model.IsMyFolders && Model.View.Available && Model.View.CanEnable && !Model.View.CanWrite)
          {
            <form method="post" asp-page-handler="Enable" asp-route-path="@currentRoute" data-requires-admin="Grant folder permissions">
              <button class="button button-secondary" type="submit">Request management</button>
            </form>
          }
          <div class="yrm-b10-file-selection" id="yrm-b10-file-selection" aria-label="Selected file actions">
            <button type="button" class="button button-secondary" data-b12-file-download disabled>Download</button>
            <button type="button" class="button button-secondary" data-b10-file-rename disabled>Rename</button>
            <button type="button" class="button button-secondary" data-b12-file-copy disabled>Copy To</button>
            <button type="button" class="button button-secondary" data-b10-file-move disabled>Move To</button>
            <button type="button" class="button button-danger" data-b10-file-delete disabled>Delete</button>
          </div>
          <form method="post" asp-page-handler="BulkDownload" asp-route-path="@currentRoute"
                data-bulk-download-form hidden>
            <button type="submit">Download selected items as ZIP</button>
          </form>
          <form method="post" asp-page-handler="BulkDelete" asp-route-path="@currentRoute"
                data-bulk-delete-form data-confirm="Delete selected items? This cannot be undone." hidden>
            <button type="submit">Confirm delete</button>
          </form>
          @if (!Model.IsMyFolders)
          {
            <a class="fm-hidden-toggle" asp-page="/Files" asp-route-path="@currentRoute" asp-route-hidden="@(!Model.Hidden)">
              @(Model.Hidden ? "Hide hidden files" : "Show hidden files")
            </a>
          }
        </div>
      <div class="fm-directory-view" data-fm-directory-view>
      @if (Model.IsMyFolders)
      {
                @if (Model.MyFiles.Count == 0)
        {
          <div class="fm-library-empty">
            <svg class="ui-icon"><use href="#i-folder"/></svg>
            <h3>No folders yet</h3>
            <p>Folders created in your home and mounted storage appear here automatically.</p>
            <div class="fm-action-row">
              <button type="button" class="button button-primary" data-open-new-folder>Create Folder</button>
            </div>
          </div>
        }
        else
        {
          <div class="responsive-table fm-my-files-table"><table class="data-table explorer-table">
            <thead><tr><th>Name</th><th>Modified</th><th>Type</th><th aria-label="Actions"></th></tr></thead>
            <tbody>
            @foreach (var folderPath in Model.MyFiles)
            {
              var name = System.IO.Path.GetFileName(folderPath);
              var exists = System.IO.Directory.Exists(folderPath);
              var relative = folderPath.TrimStart('/');
              var matching = shared.FirstOrDefault(x => string.Equals(x.Path, folderPath, StringComparison.Ordinal));
              <tr data-b10-file-row data-b10-filename="@folderPath" data-b10-absolute="@folderPath"
                  data-fm-inline-root="@(exists ? relative : "")" aria-selected="false" aria-expanded="false" tabindex="0">
                <td class="explorer-name">
                  @if (exists)
                  {
                    <button class="fm-folder-expand" type="button" data-fm-expand
                            aria-label="Expand or collapse @name" aria-expanded="false">
                      <svg class="ui-icon fm-folder-chevron" aria-hidden="true"><use href="#i-chevron"/></svg>
                    </button>
                  }
                  else { <span class="fm-folder-chevron-spacer" aria-hidden="true"></span> }
                  <a class="fm-folder-entry" data-fm-inline-folder asp-page="/Files" asp-route-path="@relative"
                     title="Double-click to open">
                    <svg class="ui-icon fm-folder-icon" aria-hidden="true"><use href="#i-folder"/></svg><span>@name</span>
                  </a>
                  @if (matching is not null) { <small class="explorer-share-mark" title="SMB shared">Shared</small> }
                </td>
                <td class="muted">@(exists ? System.IO.Directory.GetLastWriteTimeUtc(folderPath).ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "—")</td>
                <td class="muted">Folder</td>
                <td class="explorer-menu-cell">
                  <details class="explorer-item-menu"><summary aria-label="Folder actions for @name" title="Actions">⋯</summary>
                    <div class="explorer-actions-popover">
                      <a asp-page="/Files" asp-route-path="@relative">Open</a>
                      @if (exists)
                      {
                        <button type="button" data-copy-item="@name">Copy To...</button>
                        @if (FileAccess.IsManaged(System.IO.Path.GetDirectoryName(folderPath) ?? "/"))
                        {
                          <button type="button" data-move-item="@name">Move To...</button>
                          <button type="button" data-rename-item="@name">Rename</button>
                        }
                      }
                      @if (exists && matching is not null && matching.Managed)
                      {
                        <form method="post" asp-page-handler="Unshare" asp-route-path="@("@folders")" data-requires-admin="Remove SMB share">
                          <input type="hidden" name="name" value="@matching.Name"/><button type="submit">Stop sharing</button>
                        </form>
                      }
                      else if (exists && matching is null && FileAccess.IsManaged(folderPath))
                      { <button type="button" data-share-folder="@name" data-share-absolute="@folderPath">Share</button> }
                      @if (exists && !Model.QuickAccess.Contains(folderPath, StringComparer.Ordinal))
                      {
                        <form method="post" asp-page-handler="PinFolder" asp-route-path="@("@folders")">
                          <input type="hidden" name="folderPath" value="@folderPath"/><button type="submit">Pin to Quick Access</button>
                        </form>
                      }
                      else if (exists)
                      {
                        <form method="post" asp-page-handler="UnpinFolder" asp-route-path="@("@folders")">
                          <input type="hidden" name="folderPath" value="@folderPath"/><button type="submit">Unpin shortcut</button>
                        </form>
                      }
                      @if (exists && matching is null && FileAccess.IsManaged(System.IO.Path.GetDirectoryName(folderPath) ?? "/"))
                      {
                        <hr class="yrm-menu-divider" />
                        <form method="post" data-b10-row-delete asp-page-handler="DeleteLibrary" asp-route-path="@("@folders")"
                              data-confirm="Permanently delete @name and its contents? This cannot be undone.">
                          <input type="hidden" name="folderPath" value="@folderPath"/><button type="submit" class="danger">Delete folder</button>
                        </form>
                      }
                      <hr class="yrm-menu-divider" />
                      <button type="button" data-b12-properties data-b12-prop-name="@name" data-b12-prop-path="@folderPath" data-b12-prop-type="Folder" data-b12-prop-size="—" data-b12-prop-modified="—">Properties</button>
                    </div>
                  </details>
                </td>
              </tr>
            }
            </tbody>
          </table></div>
        }
      }
      else
      {
        @if (!Model.View.Available) { <div class="empty-hint">@Model.View.Error</div> }
        else
        {
          <div class="responsive-table"><table class="data-table explorer-table">
            <thead><tr><th>File name</th><th>Modified</th><th>Type</th><th>Size</th><th aria-label="Actions"></th></tr></thead>
            <tbody>
            @foreach (var item in Model.View.Items)
            {
              var child = string.IsNullOrEmpty(Model.Path) ? item.Name : Model.Path.Trim('/') + "/" + item.Name;
              var absolute = FileManagerService.Absolute(child);
              var matching = shared.FirstOrDefault(x => string.Equals(x.Path, absolute, StringComparison.Ordinal));
              var canShare = item.IsDirectory && FileAccess.IsManaged(absolute);
              var canEnable = item.IsDirectory && FileAccess.CanEnable(absolute) && !canShare;
              <tr data-b10-file-row data-b10-filename="@item.Name" data-fm-inline-root="@(item.IsDirectory ? child : "")"
                  aria-selected="false" tabindex="0">
                <td class="explorer-name">
                  @if (item.IsDirectory)
                  {
                    <button class="fm-folder-expand" type="button" data-fm-expand
                            aria-label="Expand or collapse @item.Name" aria-expanded="false">
                      <svg class="ui-icon fm-folder-chevron" aria-hidden="true"><use href="#i-chevron"/></svg>
                    </button>
                    <a class="fm-folder-entry" data-fm-inline-folder asp-page="/Files" asp-route-path="@child"
                       asp-route-hidden="@Model.Hidden" title="Double-click to open">
                      <svg class="ui-icon fm-folder-icon" aria-hidden="true"><use href="#i-folder"/></svg><span>@item.Name</span>
                    </a>
                  }
                  else
                  {
                    <span class="fm-file-entry" title="@item.Name">
                      <span class="fm-folder-chevron-spacer" aria-hidden="true"></span>
                      <span class="explorer-file-icon" aria-hidden="true">▤</span>
                      <button type="button" class="fm-file-open" data-open-file="@item.Name" title="@item.Name">@item.Name</button>
                    </span>
                  }
                  @if (matching is not null) { <small class="explorer-share-mark" title="SMB shared folder">Shared</small> }
                </td>
                <td class="muted">@item.ModifiedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                <td class="muted">@(item.IsDirectory ? "Folder" : "File")</td>
                <td class="muted" title="@(item.IsDirectory ? "Folder" : $"{item.Size:N0} bytes")">@(item.IsDirectory ? "—" : Model.FormatSize(item.Size))</td>
                <td class="explorer-menu-cell">
                  <details class="explorer-item-menu"><summary aria-label="File actions" title="Actions">⋯</summary>
                    <div class="explorer-actions-popover">
                      @if (item.IsDirectory)
                      { <a asp-page="/Files" asp-route-path="@child" asp-route-hidden="@Model.Hidden">Open</a> }
                      else
                      { <button type="button" data-b12-open-file="@item.Name">Open</button> }
                      @if (!item.IsDirectory)
                      { <a asp-page="/Files" asp-page-handler="Download" asp-route-path="@currentRoute" asp-route-name="@item.Name" data-native-download>Download</a> }
                      <button type="button" data-copy-item="@item.Name">Copy To...</button>
                      @if (Model.View.CanWrite)
                      {
                        <button type="button" data-move-item="@item.Name">Move To...</button>
                        <button type="button" data-rename-item="@item.Name">Rename</button>
                      }
                      @if (item.IsDirectory && !Model.QuickAccess.Contains(absolute, StringComparer.Ordinal) && FileAccess.IsManaged(absolute))
                      {
                        <form method="post" asp-page-handler="PinFolder" asp-route-path="@currentRoute">
                          <input type="hidden" name="folderPath" value="@absolute"/><button type="submit">Pin to Quick Access</button>
                        </form>
                      }
                      else if (item.IsDirectory && Model.QuickAccess.Contains(absolute, StringComparer.Ordinal))
                      {
                        <form method="post" asp-page-handler="UnpinFolder" asp-route-path="@currentRoute">
                          <input type="hidden" name="folderPath" value="@absolute"/><button type="submit">Unpin shortcut</button>
                        </form>
                      }
                      @if (!Model.View.CanWrite)
                      { <button type="button" data-b10-copy-path="@absolute">Copy path</button> }
                      @if (item.IsDirectory)
                      {
                        @if (matching is not null && matching.Managed)
                        {
                          <form method="post" asp-page-handler="Unshare" asp-route-path="@currentRoute" data-requires-admin="Remove SMB share">
                            <input type="hidden" name="name" value="@matching.Name"/><button type="submit">Stop sharing</button>
                          </form>
                        }
                        else if (matching is null && canShare)
                        { <button type="button" data-share-folder="@item.Name">Share</button> }
                        @if (canEnable)
                        {
                          <form method="post" asp-page-handler="EnableFolder" asp-route-path="@currentRoute" data-requires-admin="Grant folder permissions">
                            <input type="hidden" name="name" value="@item.Name"/><button type="submit">Request management</button>
                          </form>
                        }
                      }
                      @if (Model.View.CanWrite)
                      {
                        <hr class="yrm-menu-divider" />
                        <form method="post" asp-page-handler="Delete" asp-route-path="@currentRoute" data-b10-row-delete data-confirm="Permanently delete @item.Name and its contents? This cannot be undone.">
                          <input type="hidden" name="name" value="@item.Name"/><button type="submit" class="danger">Delete</button>
                        </form>
                      }
                      <hr class="yrm-menu-divider" />
                      <button type="button" data-b12-properties data-b12-prop-name="@item.Name"
                        data-b12-prop-path="@absolute" data-b12-prop-type="@(item.IsDirectory ? "Folder" : "File")"
                        data-b12-prop-size="@(item.IsDirectory ? "—" : Model.FormatSize(item.Size))"
                        data-b12-prop-modified="@item.ModifiedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")">Properties</button>
                    </div>
                  </details>
                </td>
              </tr>
            }
            </tbody>
          </table></div>
          @if (Model.View.Items.Count == 0) { <div class="empty-hint compact-empty">This folder is empty.</div> }
        }
      }
      </div>
    </div>
  </div>
</section>
<dialog id="yrm-root-upload-dialog" class="panel-modal fm-small-dialog fm-root-upload-dialog" aria-labelledby="yrm-root-upload-title">
  <div class="panel-modal-head"><strong id="yrm-root-upload-title">Upload to My Files</strong><button type="button" data-root-upload-close aria-label="Close">×</button></div>
  <form method="post" asp-page-handler="Upload" asp-route-path="@("@folders")" enctype="multipart/form-data" class="yrm-root-upload-form">
    <div class="fm-root-upload-body">
      <label for="fm-root-upload-destination">Destination</label>
      <select id="fm-root-upload-destination" name="targetParent" required>
        <option value="@Model.HomePath">Home</option>
        @foreach (var volume in Model.MountedVolumes)
        { <option value="@volume.MountPoint.TrimStart('/')">@Model.StorageLabel(volume) · @volume.MountPoint</option> }
      </select>
      <label for="fm-root-upload-file">File</label>
      <div class="fm-root-file-choice">
        <input class="fm-visually-hidden" id="fm-root-upload-file" type="file" name="upload" required />
        <button class="button button-secondary" type="button" data-file-picker="fm-root-upload-file">Choose File</button>
        <span id="fm-root-upload-name" class="muted" aria-live="polite">No file selected</span>
      </div>
    </div>
    <div class="panel-modal-actions"><button class="button button-secondary" type="button" data-root-upload-close>Cancel</button><button class="button button-primary" type="submit">Upload</button></div>
  </form>
</dialog>
<dialog id="yrm-b12-file-properties" class="panel-modal fm-small-dialog" aria-labelledby="yrm-b12-props-heading">
  <div class="panel-modal-head"><strong id="yrm-b12-props-heading">Properties</strong><button type="button" data-b12-props-close aria-label="Close">×</button></div>
  <dl class="yrm-b12-props-grid">
    <dt>Name</dt><dd id="yrm-b12-prop-name"></dd>
    <dt>Location</dt><dd id="yrm-b12-prop-path"></dd>
    <dt>Type</dt><dd id="yrm-b12-prop-type"></dd>
    <dt>Size</dt><dd id="yrm-b12-prop-size"></dd>
    <dt>Modified</dt><dd id="yrm-b12-prop-modified"></dd>
  </dl>
  <div class="panel-modal-actions"><button type="button" class="button button-secondary" data-b12-props-close>Close</button></div>
</dialog>
<dialog id="file-preview-dialog" class="panel-modal fm-preview-dialog" aria-labelledby="file-preview-title">
  <div class="panel-modal-head"><strong id="file-preview-title">Preview</strong><button type="button" data-close-dialog="file-preview-dialog" aria-label="Close">×</button></div>
  <div id="file-preview-body" class="fm-preview-body"></div>
  <div class="panel-modal-actions"><a id="file-preview-download" class="button button-secondary" data-native-download href="#">Download</a><button type="button" class="button button-secondary" data-close-dialog="file-preview-dialog">Close</button></div>
</dialog>
<dialog id="new-folder-dialog" class="panel-modal explorer-dialog yrm-create-folder-dialog" aria-labelledby="new-folder-title">
  <div class="panel-modal-head"><strong id="new-folder-title">New Folder</strong><button type="button" data-close-dialog="new-folder-dialog" aria-label="Close">×</button></div>
  <form method="post" asp-page-handler="Create" class="explorer-create-form">
    <input type="hidden" name="returnTo" value="@currentRoute"/>
    <div class="yrm-create-folder-content">
      <div class="yrm-create-folder-chooser">
        <div class="yrm-create-tree-heading">
          <strong>My Files</strong>
          <button type="button" class="yrm-create-tree-root" data-create-tree-root title="Return to filesystem root">Root /</button>
        </div>
        <div id="new-folder-tree" class="explorer-tree yrm-create-location-tree"
             data-initial-folder="@Model.DefaultCreateParent" aria-label="Choose parent folder" role="tree"></div>
      </div>
      <div class="yrm-create-folder-fields">
        <label for="new-folder-name">Folder name</label>
        <input id="new-folder-name" name="name" required maxlength="64" autocomplete="off" placeholder="New Folder"/>
        <label for="yrm-folder-volume">Location</label>
        <select id="yrm-folder-volume" aria-label="Choose a starting location">
          <option value="@Model.HomePath">Home</option>
          @foreach (var volume in Model.MountedVolumes)
          { <option value="@volume.MountPoint.TrimStart('/')">@Model.StorageLabel(volume)</option> }
          <option value="">System Root /</option>
        </select>
        <div id="new-folder-parent-text" class="yrm-create-location-path" aria-live="polite">/@Model.DefaultCreateParent</div>
        <input type="hidden" name="parent" id="new-folder-parent" value="@Model.DefaultCreateParent"/>
        <p class="muted" id="new-folder-rights" role="status"></p>
      </div>
    </div>
    <div class="panel-modal-actions"><button type="button" class="button button-secondary" data-close-dialog="new-folder-dialog">Cancel</button><button type="submit" class="button button-primary">Create Folder</button></div>
  </form>
</dialog>
<dialog id="file-action-dialog" class="panel-modal fm-small-dialog" aria-labelledby="file-action-title">
  <div class="panel-modal-head"><strong id="file-action-title">File action</strong><button type="button" data-close-dialog="file-action-dialog">×</button></div>
  <form method="post" id="file-action-form" data-current-route="@currentRoute" data-default-action-folder="@Model.HomePath">
    @Html.AntiForgeryToken()
    <input type="hidden" name="name" id="file-action-name"/>
    <input type="hidden" name="sourcePath" id="file-action-source"/>
    <div class="form-stack" id="yrm-b121-action-input-row"><label id="file-action-label">New name</label><input id="file-action-value" name="newName" required maxlength="255"/></div>
    <div id="yrm-b12-action-picker" class="yrm-b12-action-picker" hidden>

      <div id="yrm-b12-action-tree" class="explorer-tree yrm-b12-action-tree" aria-label="Choose destination folder"></div>
      <p class="muted" id="yrm-b12-action-rights" aria-live="polite"></p>
    </div>
    <div class="panel-modal-actions"><button type="button" class="button button-secondary" data-close-dialog="file-action-dialog">Cancel</button><button type="submit" class="button button-primary">Save</button></div>
  </form>
</dialog>
<dialog id="share-folder-dialog" class="panel-modal fm-small-dialog" aria-labelledby="share-folder-title">
  <div class="panel-modal-head"><strong id="share-folder-title">Share Folder</strong><button type="button" data-close-dialog="share-folder-dialog">×</button></div>
  <form method="post" asp-page-handler="Share" asp-route-path="@currentRoute" data-requires-admin="Configure folder sharing" class="fm-dialog-form">
    <input type="hidden" name="folder" id="share-folder-name"/>
    <input type="hidden" name="absoluteFolder" id="share-absolute-folder"/>
    <div class="explorer-sharing-target" id="share-folder-target"></div>
    <label>Share name<input name="shareName" id="share-folder-alias" maxlength="32" required/></label>
    <label class="fm-inline-choice"><input name="readOnly" type="checkbox" value="true"/> Read-only</label>
    @if (!Model.Samba.AccountConfigured)
    {
      <div class="fm-smb-first">
        <strong>First-time SMB setup</strong>
        <p class="muted">Create an SMB password for @Model.Samba.Account. You only need to do this once.</p>
        <label>SMB password<input name="smbPassword" type="password" minlength="12" maxlength="256" required autocomplete="new-password"/></label>
      </div>
    }
    <div class="panel-modal-actions"><button type="button" class="button button-secondary" data-close-dialog="share-folder-dialog">Cancel</button><button type="submit" class="button button-primary">Share</button></div>
  </form>
</dialog>
