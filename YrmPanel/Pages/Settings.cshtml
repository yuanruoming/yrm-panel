@page
@model YrmPanel.Pages.SettingsModel
@{
    ViewData["Title"] = "Settings";
    var sections = new[] {
        ("overview", "Overview", "i-server"),
        ("storage", "Storage", "i-harddrive"),
        ("network", "Network", "i-globe"),
        ("ddns", "Dynamic DNS", "i-globe"),
        ("security", "Firewall", "i-shield"),
        ("certificates", "Certificates", "i-shield"),
        ("appearance", "Appearance", "i-folder"),
        ("about", "About & Updates", "i-grid")
    };
    var activeTab = Model.Tab == "security" && Model.SecuritySection == "certificates"
        ? "certificates" : sections.Any(s => s.Item1 == Model.Tab) ? Model.Tab : "overview";
    var info = Model.Info;
    var snapshot = Model.Snapshot;
    var latestBuild = Model.LastUpdateCheck?.LatestHash ?? "";
}
@if (!string.IsNullOrWhiteSpace(Model.Notice) && Model.Tab != "about")
{ <div class="notice" data-result-notice="@(Model.Notice.StartsWith("Error:") ? "error" : "success")">@Model.Notice</div> }
<div class="server-settings-layout settings-rc41">
  <nav class="server-settings-nav" aria-label="Settings sections">
    <div class="yrm-settings-nav-primary">
      @foreach (var tab in sections.Where(tab => tab.Item1 != "about"))
      {
        <a class="settings-nav-link @(activeTab == tab.Item1 ? "is-active" : "")"
           asp-page="/Settings" asp-route-tab="@(tab.Item1 == "certificates" ? "security" : tab.Item1)" asp-route-section="@(tab.Item1 == "security" ? "firewall" : (tab.Item1 == "certificates" ? "certificates" : null))">
          <svg class="ui-icon"><use href="@("#" + tab.Item3)"></use></svg>
          @tab.Item2
        </a>
      }
    </div>
    <div class="yrm-settings-nav-bottom">
      <a class="settings-nav-link @(activeTab == "about" ? "is-active" : "")" asp-page="/Settings" asp-route-tab="about">
        <svg class="ui-icon"><use href="#i-grid"/></svg>About &amp; Updates
      </a>
      <div class="yrm-profile-dock">
        <button type="button" class="yrm-profile-trigger" data-yrm-profile-toggle aria-expanded="false" aria-controls="yrm-profile-popover">
          <span class="yrm-profile-photo" data-profile-avatar>
            @if (Model.HasProfilePhoto) { <img src="@Url.Page("/Settings", "ProfilePhoto", new { v = Model.ProfilePhotoVersion })" alt=""/> }
            else { <span>@Model.ProfileInitial</span> }
          </span>
          <span class="yrm-profile-ident"><strong>@Model.ProfileName</strong></span>
          <svg class="ui-icon yrm-profile-chevron"><use href="#i-chevron"/></svg>
        </button>
        <div class="yrm-profile-popover" id="yrm-profile-popover" hidden>
          <div class="yrm-profile-popover-main">
            <span class="yrm-profile-photo" aria-hidden="true">
              @if (Model.HasProfilePhoto) { <img src="@Url.Page("/Settings", "ProfilePhoto", new { v = Model.ProfilePhotoVersion })" alt=""/> }
              else { <span>@Model.ProfileInitial</span> }
            </span>
            <strong>@Model.ProfileName</strong>
          </div>
          <button type="button" class="button button-secondary" data-yrm-photo-open>Change Photo</button>
        </div>
      </div>
    </div>
    <dialog class="yrm-profile-photo-dialog" id="yrm-profile-photo-dialog" aria-labelledby="yrm-profile-photo-title">
      <div class="panel-modal-head"><strong id="yrm-profile-photo-title">Change Photo</strong><button type="button" data-yrm-photo-close aria-label="Close">×</button></div>
      <form method="post" asp-page-handler="ProfilePhoto" enctype="multipart/form-data" id="yrm-profile-photo-form">
        <div class="yrm-profile-photo-editor">
          <span class="yrm-profile-preview" id="yrm-profile-preview">
            @if (Model.HasProfilePhoto) { <img src="@Url.Page("/Settings", "ProfilePhoto", new { v = Model.ProfilePhotoVersion })" alt="Current profile photo"/> }
            else { <span>@Model.ProfileInitial</span> }
          </span>
          <label class="button button-secondary" for="yrm-profile-photo-file">Upload</label>
          <input class="fm-visually-hidden" type="file" id="yrm-profile-photo-file" name="photo" accept="image/png,image/jpeg,image/webp" required />
        </div>
        <small class="muted" id="yrm-profile-photo-hint">PNG, JPEG or WebP · Up to 2 MB</small>
        <div class="panel-modal-actions yrm-profile-photo-actions">
          @if (Model.HasProfilePhoto)
          { <button class="button button-secondary" type="submit" form="yrm-profile-restore-form">Restore Default</button> }
          <span class="yrm-profile-actions-spacer"></span>
          <button class="button button-secondary" type="button" data-yrm-photo-close>Cancel</button>
          <button class="button button-primary" type="submit" id="yrm-profile-photo-save" disabled>Save</button>
        </div>
      </form>
      @if (Model.HasProfilePhoto)
      { <form id="yrm-profile-restore-form" method="post" asp-page-handler="ClearProfilePhoto" class="yrm-profile-restore-form" hidden></form> }
    </dialog>
  </nav>
  <div class="server-settings-content">
    @if (activeTab == "overview")
    {
        var overviewVolumes = Model.StorageDevices
          .Where(d => (d.Type is "part" or "disk") && d.Uuid.Length > 0 &&
            new[] { "ext4", "xfs", "btrfs", "vfat", "exfat", "ntfs" }.Contains(d.FileSystem, StringComparer.OrdinalIgnoreCase) &&
            d.MountPoint.Length > 0 && !d.MountPoint.StartsWith("/boot", StringComparison.Ordinal) &&
            !d.MountPoint.StartsWith("/var/", StringComparison.Ordinal))
          .GroupBy(d => d.Uuid, StringComparer.Ordinal).Select(group => group.First())
          .OrderByDescending(d => d.MountPoint == "/").ThenBy(d => d.Path, StringComparer.Ordinal).ToArray();
        var primaryAdapter = info.Adapters.FirstOrDefault(a => !Model.IsVirtualAdapter(a.Name) && a.Ipv4.Length > 0)
          ?? info.Adapters.FirstOrDefault(a => !Model.IsVirtualAdapter(a.Name));
        var primaryNet = primaryAdapter is null ? null : Model.GetNetworkDetails(primaryAdapter.Name);
      <div class="yrm-overview-grid" aria-label="Server overview">
        <section class="yrm-overview-card">
          <h3>Device</h3><strong class="yrm-overview-large">@info.Hostname</strong>
          <div class="yrm-overview-sub"><span>System</span><strong>@info.OperatingSystem</strong></div>
        </section>
        <section class="yrm-overview-card">
          <h3>About YRMPanel</h3><strong class="yrm-overview-large">@info.PanelVersion.Split('+')[0]</strong>
          <a asp-page="/Settings" asp-route-tab="about" class="yrm-overview-link">Check Updates</a>
          <div class="yrm-overview-timing">
            <div><span>System Time</span><strong data-yrm-system-time data-server-epoch="@DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()" data-server-offset-minutes="@DateTimeOffset.Now.Offset.TotalMinutes">@DateTimeOffset.Now.ToString("yyyy-MM-dd HH:mm:ss")</strong></div>
            <div><span>Uptime</span><strong data-yrm-system-uptime data-uptime-seconds="@snapshot.UptimeSeconds">@($"{Math.Max(0, snapshot.UptimeSeconds) / 86400}d {Math.Max(0, snapshot.UptimeSeconds) / 3600 % 24}h {Math.Max(0, snapshot.UptimeSeconds) / 60 % 60}m {Math.Max(0, snapshot.UptimeSeconds) % 60}s")</strong></div>
          </div>
        </section>
        @for (var i = 0; i < 2; i++)
        {
          var volume = i < overviewVolumes.Length ? overviewVolumes[i] : null;
          var disk = volume is null ? null : snapshot.Disks.FirstOrDefault(d => d.Path == volume.MountPoint);
          var usedPercent = disk is not null && disk.TotalBytes > 0
            ? Math.Clamp(100d * disk.UsedBytes / disk.TotalBytes, 0d, 100d) : 0d;
          var percentCss = usedPercent.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
          <section class="yrm-overview-card yrm-overview-volume">
            <div class="yrm-overview-card-head">
              <h3>@(i == 0 && volume?.MountPoint == "/" ? "System Volume" : $"Volume {i + 1}")</h3>
              @if (i == 1 && overviewVolumes.Length > 2)
              { <a asp-page="/Settings" asp-route-tab="storage" class="yrm-overview-link">More</a> }
            </div>
            @if (disk is not null && disk.TotalBytes > 0)
            {
              <div class="yrm-overview-volume-body">
                <div class="yrm-volume-donut" style="--used:@percentCss%" aria-label="@percentCss percent used">
                  <span>@usedPercent.ToString("0")%</span>
                </div>
                <div class="yrm-volume-amounts">
                  <div><span>Used</span><strong>@((disk.UsedBytes / 1073741824d).ToString("0.0")) GiB</strong></div>
                  <div><span>Free</span><strong>@(((disk.TotalBytes - disk.UsedBytes) / 1073741824d).ToString("0.0")) GiB</strong></div>
                </div>
              </div>
            }
            else
            { <p class="muted">@(volume is null ? "No additional volume" : "Capacity unavailable")</p> }
          </section>
        }
        <section class="yrm-overview-card">
          <h3>Hardware Info</h3>
          <div class="yrm-overview-kv"><span>CPU</span><strong>@info.CpuModel · @info.Processors cores</strong></div>
          <div class="yrm-overview-kv"><span>RAM</span><strong>@(info.MemoryBytes > 0 ? (info.MemoryBytes / 1073741824d).ToString("0.0") + " GiB" : "—")</strong></div>
          <div class="yrm-overview-kv"><span>GPU</span><strong>Not available</strong></div>
        </section>
        <section class="yrm-overview-card">
          <h3>Network</h3>
          <div class="yrm-overview-kv"><span>IPv4</span><strong>@(primaryAdapter?.Ipv4.FirstOrDefault() ?? "—")</strong></div>
          <div class="yrm-overview-kv"><span>IPv6</span><strong>@(primaryAdapter?.Ipv6.FirstOrDefault(x => !Model.IsLinkLocalIpv6(x)) ?? "—")</strong></div>
          <div class="yrm-overview-kv"><span>MAC</span><strong>@(primaryNet?.Mac ?? "—")</strong></div>
          <div class="yrm-overview-kv"><span>Speed</span><strong>@(primaryNet?.LinkSpeed ?? "—")</strong></div>
        </section>
      </div>
    }
    else if (activeTab == "storage")
    {

      <nav class="yrm-b10-storage-tabs" aria-label="Storage sections">
        <button type="button" class="is-active" data-b10-storage-tab="volumes" aria-pressed="true">Storage Spaces</button>
        <button type="button" data-b10-storage-tab="disks" aria-pressed="false">Physical Disks</button>
      </nav>
      // Filesystem identity comes from lsblk UUID, while current mount data
      // and capacity come from the host. Do not invent a parallel volume DB.
        var volumes = Model.StorageDevices
          .Where(d => (d.Type is "part" or "disk") && d.Uuid.Length > 0 &&
              new[] { "ext4", "xfs", "btrfs", "vfat", "exfat", "ntfs" }
                .Contains(d.FileSystem, StringComparer.OrdinalIgnoreCase) &&
              !d.MountPoint.StartsWith("/boot", StringComparison.Ordinal) &&
              !d.MountPoint.StartsWith("/var/", StringComparison.Ordinal))
          .GroupBy(d => d.Uuid, StringComparer.Ordinal).Select(g => g.First())
          .OrderByDescending(d => d.MountPoint == "/")
          .ThenBy(d => d.MountPoint.Length == 0)
          .ThenBy(d => d.Path, StringComparer.Ordinal).ToArray();
      var volumeNumber = 0;
      <section class="yrm-flat-panel yrm-storage-section yrm-b9-volume-section" data-b10-storage-panel="volumes">
        <div class="yrm-b9-volume-grid">
          @foreach (var volume in volumes)
          {
            volumeNumber++;
            var capacity = snapshot.Disks.FirstOrDefault(d => d.Path == volume.MountPoint);
            var isSystem = volume.MountPoint == "/";
            <article class="yrm-b9-volume-card">
              <div class="yrm-b9-volume-head"><div><small class="eyebrow">Volume @volumeNumber · @(isSystem ? "System" : "Storage")</small><h3>@(volume.MountPoint.Length > 0 ? volume.MountPoint : "Not mounted")</h3></div><span class="tag">@(volume.MountPoint.Length == 0 ? "Offline" : "Mounted")</span></div>
              @if (capacity is not null && capacity.TotalBytes > 0)
              {
                <div class="meter-track"><div class="meter-fill cpu" style="width:@((100.0 * capacity.UsedBytes / capacity.TotalBytes).ToString("0.0",System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
                <p class="muted">@((capacity.UsedBytes / 1073741824d).ToString("0.0")) GiB used of @((capacity.TotalBytes / 1073741824d).ToString("0.0")) GiB</p>
              }
              else { <p class="muted">@volume.Size · @volume.FileSystem</p> }
              <small class="yrm-b9-volume-meta">@volume.Name · @volume.FileSystem · UUID: @volume.Uuid</small>
              @if (volume.MountPoint.Length == 0 && volume.CanMount)
              {
                <form method="post" asp-page-handler="Mount" asp-route-tab="storage" data-requires-admin="Mount existing Linux filesystem" class="yrm-mount-form">
                  <input type="hidden" name="uuid" value="@volume.Uuid" />
                  <label>Mount location<input name="mountPath" required value="@Model.SuggestedMountPath(volume)" /></label>
                  <label class="v1-check"><input type="checkbox" name="automatic" value="true" checked /> Mount on startup</label>
                  <button class="button button-primary" type="submit">Mount</button>
                </form>
              }
              else if (volume.ManagedMount && !isSystem && volume.MountPoint.Length > 0)
              {
                <div class="yrm-b9-volume-action yrm-b10-volume-action">
                  @if (!Model.Sharing.Available)
                  { <small class="muted">Cannot verify SMB sharing; unmount is unavailable.</small> }
                  else if (Model.HasVolumeShares(volume.MountPoint))
                  { <small class="muted">Stop sharing folders on this volume before unmounting.</small> }
                  else
                  {
                    <form method="post" asp-page-handler="Unmount" asp-route-tab="storage" data-requires-admin="Unmount volume" data-confirm="Unmount @volume.MountPoint? Open files or active services may prevent this operation.">
                      <input type="hidden" name="mountPath" value="@volume.MountPoint" />
                      <input type="hidden" name="uuid" value="@volume.Uuid" />
                      <button class="button button-secondary" type="submit">Unmount volume</button>
                    </form>
                  }
                </div>
              }
              else if (!isSystem && volume.MountPoint.Length > 0)
              { <small class="muted">Mount managed outside YRM Panel. Read-only status.</small> }
            </article>
          }
        </div>
        @if (volumes.Length == 0) { <p class="muted">No recognized filesystems found.</p> }
      </section>
      <section class="yrm-flat-panel yrm-storage-section yrm-b9-physical-section" data-b10-storage-panel="disks" hidden>
        @foreach (var disk in Model.StorageDevices.Where(x => x.Type == "disk"))
        {
          <article class="yrm-disk-card">
            <div class="yrm-disk-title"><svg class="ui-icon"><use href="#i-harddrive"/></svg><div><strong>@disk.Name</strong><small>@disk.Path · @disk.Size @(disk.Removable ? "· Removable" : "")</small></div></div>
            @foreach (var part in Model.StorageDevices.Where(x => x.ParentPath == disk.Path).Prepend(disk)
                .Where(x => (x.Type == "part" || x.Type == "disk") && (x != disk || x.FileSystem.Length > 0) && !Model.IsSmallUnformatted(x)))
            {
              <div class="yrm-partition-card yrm-b9-physical-partition">
                <strong>@part.Name · @(part.Label.Length > 0 ? part.Label : (part.FileSystem.Length > 0 ? part.FileSystem : "No filesystem"))</strong>
                <small>@part.Size · @(part.MountPoint.Length > 0 ? "Mounted at " + part.MountPoint : "Not mounted")</small>
                @if (part.Uuid.Length > 0) { <small>UUID: @part.Uuid</small> }
                @if (part.FileSystem.Length == 0 && part.Type == "part" && !part.ReadOnly && !part.Removable &&
                     part.MountPoint.Length == 0 && part.Uuid.Length == 0 &&
                     Model.StorageDevices.Count(x => x.ParentPath == disk.Path) == 1 &&
                     disk.MountPoint.Length == 0 && !disk.ReadOnly && !disk.Removable)
                {
                  <details class="yrm-disk-initialize"><summary class="button button-secondary">Complete Incomplete Setup</summary>
                    <form method="post" asp-page-handler="CompleteDisk" asp-route-tab="storage"
                          data-requires-admin="Format verified empty partition" data-confirm="This will FORMAT the selected empty partition. Continue?">
                      <input type="hidden" name="partitionPath" value="@part.Path" />
                      <p class="yrm-storage-warning">Formats only a verified blank partition. Existing filesystems are refused.</p>
                      <label>Confirm exactly: <code>FORMAT @part.Path</code><input name="confirmation" required autocomplete="off" placeholder="FORMAT @part.Path" /></label>
                      <button type="submit" class="button button-danger">Verify &amp; Complete Setup</button>
                    </form>
                  </details>
                }
              </div>
            }
            @if (Model.StorageDevices.Any(x => x.ParentPath == disk.Path && Model.IsSmallUnformatted(x)))
            { <details class="yrm-small-partitions"><summary>System / reserved partitions</summary>
                @foreach (var reserved in Model.StorageDevices.Where(x => x.ParentPath == disk.Path && Model.IsSmallUnformatted(x)))
                { <p class="muted">@reserved.Name · @reserved.Size · Reserved / unformatted</p> }
              </details> }
            @if (!Model.StorageDevices.Any(x => x.ParentPath == disk.Path) && disk.FileSystem.Length == 0 &&
                 !disk.ReadOnly && !disk.Removable && disk.MountPoint.Length == 0 && disk.Uuid.Length == 0)
            {
              <details class="yrm-disk-initialize"><summary class="button button-secondary">Initialize Empty Disk</summary>
                <form method="post" asp-page-handler="InitializeDisk" asp-route-tab="storage"
                      data-requires-admin="Permanently erase selected blank disk" data-confirm="This will erase the selected disk and cannot be undone. Continue?">
                  <input type="hidden" name="diskPath" value="@disk.Path" />
                  <p class="yrm-storage-warning"><strong>Destructive:</strong> Creates GPT and ext4 only on a verified empty disk. Existing signatures are refused.</p>
                  <label>Confirm exactly: <code>ERASE @disk.Path</code><input name="confirmation" required autocomplete="off" placeholder="ERASE @disk.Path" /></label>
                  <button type="submit" class="button button-danger">Erase &amp; Initialize</button>
                </form>
              </details>
            }
          </article>
        }
        @if (!Model.StorageDevices.Any(x => x.Type == "disk")) { <p class="muted">No physical disks reported by lsblk.</p> }
      </section>
    }
    else if (activeTab == "network")
    {
      <div class="yrm-network-layout">
      @foreach (var adapter in info.Adapters.Where(x => !Model.IsVirtualAdapter(x.Name)))
      {
        var net = Model.GetNetworkDetails(adapter.Name);
        <section class="yrm-network-interface" aria-label="Network interface @adapter.Name">
          <div class="yrm-network-interface-head">
            <h3>@adapter.Name</h3>
            
          </div>
          <section class="yrm-network-family">
            <h4>IPv4</h4>
            <dl>
              <div><dt>Type</dt><dd>@net.Ipv4Mode</dd></div>
              <div><dt>IP Address</dt><dd>@(adapter.Ipv4.Length > 0 ? string.Join(", ", adapter.Ipv4) : "—")</dd></div>
              <div><dt>Subnet Mask</dt><dd>@net.SubnetMask</dd></div>
              <div><dt>Gateway</dt><dd>@net.Ipv4Gateway</dd></div>
              <div><dt>DNS</dt><dd>@net.Ipv4Dns</dd></div>
            </dl>
          </section>
          <section class="yrm-network-family">
            <h4>IPv6</h4>
            <dl>
              <div><dt>Type</dt><dd>@net.Ipv6Mode</dd></div>
              <div><dt>IP Address</dt><dd>@(adapter.Ipv6.Any(x => !Model.IsLinkLocalIpv6(x)) ? string.Join(", ", adapter.Ipv6.Where(x => !Model.IsLinkLocalIpv6(x))) : "—")</dd></div>
              <div><dt>Prefix Length</dt><dd>@net.Ipv6Prefix</dd></div>
              <div><dt>Gateway</dt><dd>@net.Ipv6Gateway</dd></div>
              <div><dt>DNS</dt><dd>@net.Ipv6Dns</dd></div>
            </dl>
           </section>
           <section class="yrm-network-family yrm-network-interface-details">
             <h4>Interface Details</h4>
             <dl>
               <div><dt>Link Speed</dt><dd>@net.LinkSpeed</dd></div>
               <div><dt>MTU</dt><dd>@net.Mtu</dd></div>
               <div><dt>MAC Address</dt><dd>@net.Mac</dd></div>
             </dl>
          </section>
        </section>
      }
      @if (info.Adapters.Count == 0) { <p class="muted">No network interfaces detected.</p> }
      </div>
    }
    else if (activeTab == "ddns")
    {
      <div class="yrm-settings-toolbar yrm-ddns-header-actions">
        <h3 class="yrm-ddns-workspace-title">Dynamic DNS</h3>
        <form method="post" asp-page-handler="DdnsUpdateAll" asp-route-tab="ddns">
          <button class="button button-secondary" type="submit" disabled="@(Model.DdnsProfiles.Count == 0)">Update</button>
        </form>
        <button class="button button-primary" type="button" data-b9-ddns-add>+ Add Provider</button>
      </div>
      <section class="yrm-flat-panel yrm-b11-ddns-panel">
        <div class="yrm-b11-table-wrap">
          <table class="yrm-b11-table yrm-b11-ddns-table">
            <thead><tr><th>Provider</th><th>Domain</th><th>IPv4</th><th>IPv6</th><th class="yrm-b11-actions-head">Actions</th></tr></thead>
            <tbody>
            @foreach (var group in Model.DdnsProfiles.GroupBy(p => new { Provider = p.Provider.ToLowerInvariant(), Hostname = p.Hostname.ToLowerInvariant() }))
            {
              var v4 = group.FirstOrDefault(p => p.RecordType == "A");
              var v6 = group.FirstOrDefault(p => p.RecordType == "AAAA");
              var lastRun = group.OrderByDescending(p => p.LastRun).FirstOrDefault()?.LastRun;
              var failed = group.Any(p => p.LastStatus.StartsWith("Failed", StringComparison.OrdinalIgnoreCase));
              var active = group.Any(p => p.Enabled && p.IpSource != "disabled");
              var groupStatus = !active ? "Disabled" : failed ? "Failed" : group.Any(p => p.LastStatus is "Updated" or "Unchanged" or "IP unchanged") ? "Normal" : "Not checked";
              <tr class="yrm-b11-ddns-row" data-b9-ddns-provider="@group.Key.Provider" data-b9-ddns-hostname="@group.Key.Hostname">
                <td class="yrm-b11-provider-cell"><strong>@(char.ToUpperInvariant(group.Key.Provider[0]) + group.Key.Provider.Substring(1))</strong><span data-b9-ddns-status data-b10-state="@groupStatus.ToLowerInvariant()" hidden>@groupStatus</span></td>
                <td class="yrm-b11-domain" title="@group.Key.Hostname">@group.Key.Hostname</td>
                @foreach (var profile in new[] { v4, v6 })
                {
                  <td class="yrm-b11-ip-cell">
                    @if (profile is null) { <span class="yrm-b11-ip-state is-off">—</span> }
                    else
                    {
                      var isOff = !profile.Enabled || profile.IpSource == "disabled";
                      var isFailed = profile.LastStatus.StartsWith("Failed", StringComparison.OrdinalIgnoreCase);
                      var isOk = profile.LastStatus is "Updated" or "Unchanged" or "IP unchanged";
                      var state = isOff ? "Off" : isFailed ? "Failed" : isOk ? "Normal" : "Not checked";
                      <div data-b9-ddns-record="@profile.Id" title="@profile.LastStatus" class="yrm-b11-ip-result" data-b12-ddns-detail tabindex="0" role="button" aria-label="View @profile.RecordType update details">
                        <span class="yrm-b11-ip-state @(isFailed ? "is-failed" : isOff ? "is-off" : isOk ? "is-normal" : "is-unknown")" data-b11-family-state>@state</span>
                        <small data-b9-ddns-ip title="Detected IP">@(isOff ? "Disabled" : profile.LastIp.Length > 0 ? profile.LastIp : "Not checked")</small>
                        <span data-b9-ddns-checked hidden>@(profile.LastRun is { } checkedAt ? checkedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm") : "Not checked yet")</span>
                        <span data-b9-ddns-error hidden>@(isFailed ? profile.LastStatus : "")</span>
                      </div>
                    }
                  </td>
                }
                <td class="yrm-b11-ddns-actions">
                  <div class="yrm-b11-action-row">
                    <button type="button" class="button button-secondary" data-yrm-ddns-edit="yrm-b10-ddns-edit-@group.First().Id">Edit</button>
                    <form method="post" asp-page-handler="DdnsDeleteGroup" asp-route-tab="ddns" data-confirm="Remove this DDNS configuration? Existing DNS records will not be deleted.">
                      <input type="hidden" name="hostname" value="@group.Key.Hostname" />
                      <input type="hidden" name="provider" value="@group.Key.Provider" />
                      <button type="submit" class="button button-secondary yrm-b11-remove">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            }
            </tbody>
          </table>
        </div>
        @if (Model.DdnsProfiles.Count == 0) { <p class="muted yrm-b11-empty">No DDNS providers configured.</p> }
      </section>
      <dialog id="yrm-b12-ddns-detail" class="yrm-ddns-editor yrm-b12-ddns-detail" aria-label="DNS update details">
        <div class="panel-modal-head"><strong>DNS Update Details</strong><button type="button" data-b12-ddns-close aria-label="Close">×</button></div>
        <pre id="yrm-b12-ddns-message" class="yrm-b12-ddns-message"></pre>
        <div class="panel-modal-actions"><button type="button" class="button button-secondary" data-b12-ddns-close>Close</button></div>
      </dialog>
      @foreach (var group in Model.DdnsProfiles.GroupBy(p => new { Provider = p.Provider.ToLowerInvariant(), Hostname = p.Hostname.ToLowerInvariant() }))
      {
        var primary = group.First();
        var ipv4 = group.FirstOrDefault(p => p.RecordType == "A");
        var ipv6 = group.FirstOrDefault(p => p.RecordType == "AAAA");
        <dialog id="yrm-b10-ddns-edit-@primary.Id" class="yrm-ddns-editor yrm-b10-ddns-dialog" aria-label="Edit DDNS provider">
          <div class="panel-modal-head"><strong>Edit @primary.Provider · @primary.Hostname</strong><button type="button" data-yrm-ddns-edit-close aria-label="Close">×</button></div>
          <form method="post" asp-page-handler="DdnsEditGroup" asp-route-tab="ddns" autocomplete="off">
            <div class="yrm-ddns-dialog-body">
            <input type="hidden" name="provider" value="@primary.Provider" />
            <input type="hidden" name="originalHostname" value="@primary.Hostname" />
            <input type="hidden" name="name" value="@primary.Name" />
            <label>Hostname<input name="hostname" required readonly value="@primary.Hostname" autocomplete="off" /></label>
            @if (primary.Provider == "dynu")
            { <label>Dynu username<input name="username" value="@primary.Username" required autocomplete="off" /></label> }
            else { <input type="hidden" name="username" value="@primary.Username"/> }
            <label>@(primary.Provider == "cloudflare" ? "Cloudflare API Token" : primary.Provider == "dynu" ? "IP Update Password" : "API credential")
              <span class="yrm-b10-secret-field"><input name="token" type="password" autocomplete="new-password" placeholder="Leave empty to keep saved credential" /><button type="button" class="yrm-b9-secret-toggle" data-b9-secret-toggle>Show</button></span>
              <small>Existing credential is retained when blank. Enter it again to add another IP record.</small>
            </label>
            <div class="yrm-b10-ddns-families">
              @foreach (var family in new[] { (Type: "A", Label: "IPv4 · A Record", Item: ipv4), (Type: "AAAA", Label: "IPv6 · AAAA Record", Item: ipv6) })
              {
                var suffix = family.Type == "A" ? "4" : "6";
                var selected = family.Item is not null && family.Item.IpSource != "disabled";
                <div class="yrm-b10-ddns-family" data-b10-family="@suffix">
                  <label class="v1-check yrm-b11-toggle-line"><span>@family.Label</span><input type="checkbox" name="@(suffix == "4" ? "ipv4Enabled" : "ipv6Enabled")" value="true" checked="@selected" disabled="@(primary.Provider == "custom" && family.Item is null)"/><span class="yrm-b11-switch" aria-hidden="true"></span></label>
                  <label>Address source<select name="@("ipSource" + suffix)" data-b10-source-select>
                    <option value="public" selected="@(family.Item?.IpSource is null or "disabled" or "public")">Automatic public IP</option>
                    <option value="interface" selected="@(family.Item?.IpSource == "interface")">Network interface</option>
                    <option value="manual" selected="@(family.Item?.IpSource == "manual")">Manual IP</option>
                  </select></label>
                  <label data-b10-source-field="manual" hidden="@(family.Item?.IpSource != "manual")">Manual IP<input name="@("manualIp" + suffix)" value="@(family.Item?.ManualIp ?? "")" /></label>
                  <label data-b10-source-field="interface" hidden="@(family.Item?.IpSource != "interface")">Network interface
                    <select name="@("interfaceName" + suffix)"><option value="">Select interface</option>
                      @foreach (var item in Model.DdnsNetworkInterfaces)
                      { <option value="@item" selected="@(family.Item?.InterfaceName == item)">@item</option> }
                    </select>
                  </label>
                </div>
              }
            </div>
            @if (primary.Provider == "custom")
            {
              <details><summary>Custom API settings</summary>
                <label>HTTPS URL<input name="apiUrl" required value="@primary.UrlTemplate" /></label>
                <label>HTTP method<select name="httpMethod">
                  @foreach (var m in new[] { "GET", "POST", "PUT", "PATCH" }) { <option value="@m" selected="@(primary.HttpMethod == m)">@m</option> }
                </select></label>
                <label>Authentication<select name="authType">
                  @foreach (var a in new[] { "none", "basic", "bearer", "header" }) { <option value="@a" selected="@(primary.AuthType == a)">@a</option> }
                </select></label>
                <label>Header name<input name="headerName" value="@primary.HeaderName"/></label>
                <label>JSON body<textarea name="bodyTemplate" rows="3">@primary.BodyTemplate</textarea></label>
                <label>Response mode<select name="responseMode">
                  @foreach (var m in new[] { "codes", "json", "http" }) { <option value="@m" selected="@(primary.ResponseMode == m)">@m</option> }
                </select></label>
                <label>Success codes<input name="successCodes" value="@primary.SuccessCodes"/></label>
                <label>Unchanged codes<input name="unchangedCodes" value="@primary.UnchangedCodes"/></label>
                <label>Error codes<input name="errorCodes" value="@primary.ErrorCodes"/></label>
                <label>JSON property<input name="jsonProperty" value="@primary.JsonProperty"/></label>
                <label>Expected JSON value<input name="jsonExpected" value="@primary.JsonExpected"/></label>
              </details>
            }
            <label>Update interval (minutes)<input type="number" name="intervalMinutes" min="5" max="1440" required value="@primary.IntervalMinutes" /></label>
            <label class="v1-check yrm-b11-toggle-line"><span>Enable automatic updates</span><input name="enabled" type="checkbox" value="true" checked="@primary.Enabled"/><span class="yrm-b11-switch" aria-hidden="true"></span></label>
            </div>
            <div class="panel-modal-actions"><button class="button button-secondary" type="button" data-yrm-ddns-edit-close>Cancel</button><button class="button button-primary" type="submit">Save Changes</button></div>
          </form>
        </dialog>
      }
      <dialog id="yrm-b9-ddns-add" class="yrm-ddns-editor yrm-b9-ddns-dialog" aria-label="Add Provider">
        <div class="panel-modal-head"><strong>Add Provider</strong><button type="button" data-b9-ddns-cancel aria-label="Close">×</button></div>
          <form method="post" asp-page-handler="DdnsAddGroup" asp-route-tab="ddns" id="yrm-ddns-new-form">
            <div class="yrm-ddns-dialog-body">
            <label>Provider template
              <div class="yrm-b10-provider-picker" data-b10-provider-picker>
                <select id="yrm-ddns-provider-preset" aria-label="DDNS provider"><option value="dynu4">Dynu</option><option value="cloudflare4">Cloudflare</option><option value="custom">Custom HTTPS API</option></select>
                <button type="button" data-b10-provider-toggle aria-haspopup="listbox" aria-expanded="false">Dynu <svg class="yrm-b11-select-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                <div class="yrm-b10-provider-options" data-b10-provider-options role="listbox" hidden>
                  <button type="button" role="option" data-b10-provider-option="dynu4" aria-selected="true">Dynu</button>
                  <button type="button" role="option" data-b10-provider-option="cloudflare4" aria-selected="false">Cloudflare</button>
                  <button type="button" role="option" data-b10-provider-option="custom" aria-selected="false">Custom HTTPS API</button>
                </div>
              </div>
            </label>
            <p id="yrm-ddns-provider-note" class="muted">Dynu: enter your hostname, username and IP Update Password.</p>
            <input type="hidden" name="name" value="Dynu" />
            <label>Hostname<input name="hostname" required placeholder="nas.example.com" /></label>
            <div class="yrm-b10-ddns-families">
              @foreach (var family in new[] { (Suffix: "4", Label: "IPv4 · A Record"), (Suffix: "6", Label: "IPv6 · AAAA Record") })
              {
                <div class="yrm-b10-ddns-family" data-b10-family="@family.Suffix">
                  <label class="v1-check yrm-b11-toggle-line"><span>@family.Label</span><input type="checkbox" name="@(family.Suffix == "4" ? "ipv4Enabled" : "ipv6Enabled")" value="true" checked="@(family.Suffix == "4")"/><span class="yrm-b11-switch" aria-hidden="true"></span></label>
                  <label>Address source<select name="@("ipSource" + family.Suffix)" data-b10-source-select>
                    <option value="public">Automatic public IP</option>
                    <option value="interface">Network interface</option>
                    <option value="manual">Manual IP</option>
                  </select></label>
                  <label data-b10-source-field="manual" hidden>Manual IP<input name="@("manualIp" + family.Suffix)" autocomplete="off" /></label>
                  <label data-b10-source-field="interface" hidden>Network interface
                    <select name="@("interfaceName" + family.Suffix)"><option value="">Select interface</option>
                      @foreach (var iface in Model.DdnsNetworkInterfaces)
                      { <option value="@iface">@iface</option> }
                    </select>
                  </label>
                </div>
              }
            </div>
            <small class="muted">Choose IPv4, IPv6 or both. Dynu and Cloudflare share provider credentials.</small>
            <div class="v1-grid" data-ddns-technical>
              <label>Record type<select name="recordType"><option>A</option><option>AAAA</option></select></label>
              <label>Method<select name="httpMethod"><option>GET</option><option>POST</option><option>PUT</option><option>PATCH</option></select></label>
            </div>
            <label data-ddns-technical>Provider HTTPS API URL<input name="urlTemplate" type="text" required placeholder="https://api.example.com/update?hostname={hostname}&amp;myip={ip}" spellcheck="false" /></label>
            <div class="v1-grid">
              <label>Authentication
                <select name="authType" id="yrm-ddns-auth"><option value="basic">HTTP Basic</option><option value="bearer">Bearer token</option><option value="header">Custom header</option><option value="none">None</option></select>
              </label>
              <label data-ddns-auth="basic">Username<input name="username" autocomplete="new-password" placeholder="Dynu username" /></label>
            </div>
            <div class="v1-grid">
              <label data-ddns-auth="header">Header name<input name="headerName" value="Authorization" placeholder="Authorization" /></label>
              <label><span id="yrm-ddns-secret-label">Credential / API token</span><span class="yrm-b10-secret-field"><input name="token" type="password" autocomplete="new-password" placeholder="" /><button type="button" class="yrm-b9-secret-toggle" data-b9-secret-toggle>Show</button></span></label>
            </div>
            <label data-ddns-technical>JSON body (optional)<textarea rows="3" name="bodyTemplate" placeholder='{"type":"A","name":"{hostname}","content":"{ip}"}'></textarea></label>
            <details class="yrm-ddns-advanced"><summary>Advanced settings</summary>
              <label>Custom public IP detection URL (optional)
                <input name="detectionUrl" type="url" placeholder="Automatic (two HTTPS detection sources)" spellcheck="false" />
                <small>Leave empty to detect IPv4/IPv6 automatically. A custom URL must return only a public IP address.</small>
              </label>
              <label>Response validation
                <select name="responseMode" id="yrm-ddns-response-mode"><option value="codes">Text response codes</option><option value="json">JSON property</option><option value="http">HTTP 2xx only</option></select>
              </label>
              <div data-ddns-response="codes" class="v1-grid">
                <label>Success codes<input name="successCodes" value="good" placeholder="good" /></label>
                <label>Unchanged codes<input name="unchangedCodes" value="nochg" placeholder="nochg" /></label>
                <label>Error codes<input name="errorCodes" value="badauth,nohost,notfqdn,unknown,servererror,911" /></label>
              </div>
              <div data-ddns-response="json" class="v1-grid" hidden>
                <label>JSON property path<input name="jsonProperty" value="success" placeholder="success" /></label>
                <label>Expected value<input name="jsonExpected" value="true" placeholder="true" /></label>
              </div>
              <label class="v1-check"><input type="checkbox" name="verifyDns" value="true" checked /> Verify A / AAAA DNS record after updating</label>
              <input type="hidden" name="verifyDns" value="false" />

              <p class="muted">Variables: {hostname}, {ip}, {ipv4}, {ipv6}. DNS caches or proxies may temporarily show a different IP.</p>
            </details>
            <label>Update interval (minutes)<input name="intervalMinutes" type="number" min="5" max="1440" value="10" required /></label>
            <label class="v1-check yrm-b11-toggle-line"><span>Enable automatic updates</span><input type="checkbox" name="enabled" value="true" checked /><span class="yrm-b11-switch" aria-hidden="true"></span></label>
            <input type="hidden" name="provider" id="yrm-ddns-provider" value="dynu" />
            <input type="hidden" name="successContains" value="" />
            </div>
            <div class="panel-modal-actions"><button class="button button-secondary" type="button" data-b9-ddns-cancel>Cancel</button><button class="button button-primary" type="submit">Save Provider</button></div>
          </form>
      </dialog>
    }
    else if (activeTab is "security" or "certificates")
    {
      @if (Model.SecuritySection == "firewall")
      {
        @if (!Model.Firewall.Available)
        {
          <div class="yrm-fw-unavailable" role="alert">Firewall is unavailable. <details><summary>Technical details</summary><pre>@Model.Firewall.Status</pre></details></div>
        }
        else
        {
          @if (!string.IsNullOrWhiteSpace(Model.Firewall.PendingConfirmation))
          {
            <div class="yrm-firewall-pending">
              <strong>Confirm connectivity</strong>
              <p>Keep firewall enabled within 120 seconds or changes will roll back.</p>
              <form method="post" asp-page-handler="FirewallConfirm" asp-route-tab="security" asp-route-section="firewall">
                <input type="hidden" name="nonce" value="@Model.Firewall.PendingConfirmation" />
                <button class="button button-primary" type="submit">Keep Enabled</button>
              </form>
            </div>
          }
          <form id="v1-firewall-form" class="yrm-fw-workspace" method="post" asp-page-handler="Firewall" asp-route-tab="security" asp-route-section="firewall" data-requires-admin="Apply firewall changes">
            <div class="yrm-fw-status-line">
              <strong>Firewall Status</strong>
              <label class="yrm-fw-enable" for="yrm-fw-enabled">
                <span id="yrm-fw-status-text">@(Model.Firewall.Active ? "On" : "Off")</span>
                <input id="yrm-fw-enabled" type="checkbox" name="firewallEnabled" value="true" checked="@Model.Firewall.Active" role="switch" aria-label="Enable firewall" />
                <input type="hidden" name="firewallEnabled" value="false" />
                <span class="yrm-fw-switch" aria-hidden="true"></span>
              </label>
            </div>
            <div class="yrm-fw-rules-heading">
              <strong>Rules</strong>
              <button type="button" class="button button-secondary" data-b11-fw-add>+ Add Rule</button>
            </div>
            <div class="yrm-fw-rule-scroll"><table class="yrm-b11-table yrm-b11-fw-table">
              <thead><tr><th>Direction</th><th>Port</th><th>Protocol</th><th>IP Address</th><th>Permission</th><th>Remarks</th></tr></thead>
              <tbody id="yrm-b11-fw-body"><tr><td colspan="6" class="muted">No rules configured.</td></tr></tbody>
            </table></div>
            <div id="v1-firewall-rules" hidden data-initial="@(System.Text.Json.JsonSerializer.Serialize(Model.Firewall.Rules.Select(x=>new {scope=x.Scope,direction=x.Direction,action=x.Action,port=x.Port,protocol=x.Protocol,source=x.Source,remarks=x.Remarks})))"></div>
            <input type="hidden" id="v1-fw-json" name="rulesJson" value="[]" />
            <button type="button" hidden data-fw-add aria-hidden="true" tabindex="-1">Add draft rule</button>
            <div class="yrm-fw-footer">
              <span id="v1-fw-dirty" aria-live="polite"></span>
              <button type="button" class="button button-secondary" data-b11-fw-discard>Cancel</button>
              <button type="submit" class="button button-primary">Save</button>
            </div>
          </form>
          <dialog id="yrm-b11-fw-dialog" class="yrm-ddns-editor yrm-b11-fw-dialog" aria-labelledby="yrm-b11-fw-title">
            <div class="panel-modal-head"><strong id="yrm-b11-fw-title">Firewall Rule</strong><button type="button" data-b11-fw-cancel aria-label="Close">×</button></div>
            <div class="yrm-b11-fw-fields">
              <label>Direction<select data-b11-fw-field="direction"><option value="inbound">Inbound</option><option value="outbound">Outbound</option></select></label>
              <label>Permission<select data-b11-fw-field="action"><option value="allow">Allow</option><option value="deny">Deny</option><option value="lan">LAN only (Docker)</option></select></label>
              <label>Port<input data-b11-fw-field="port" placeholder="80,443 or 20-442" inputmode="numeric" /></label>
              <label>Protocol<select data-b11-fw-field="protocol"><option value="tcp">TCP</option><option value="udp">UDP</option></select></label>
              <label class="yrm-b11-fw-source">IP Address
                <select data-b11-fw-source-mode aria-label="Address mode"><option value="any">Any</option><option value="custom">Custom IP / CIDR</option></select>
              </label>
              <label class="yrm-b11-fw-source-address"><span data-b11-fw-address-label>Source IP / CIDR</span>
                <input data-b11-fw-field="source" placeholder="192.168.0.0/24" disabled />
              </label>
              <label>Remarks<input data-b11-fw-field="remarks" maxlength="60" placeholder="Optional" /></label>
              <details class="yrm-fw-rule-advanced"><summary>Advanced</summary>
                <label>Backend<select data-b11-fw-field="scope"><option value="host">Ubuntu (UFW)</option><option value="docker">Docker (IPv4 inbound)</option></select></label>
                <small>Docker publishes ports through a separate forwarding path. Docker outbound filtering is not supported here.</small>
              </details>
            </div>
            <p class="yrm-inline-error" id="yrm-b11-fw-error" hidden></p>
            <div class="panel-modal-actions"><button type="button" class="button button-secondary" data-b11-fw-cancel>Cancel</button><button type="button" class="button button-primary" data-b11-fw-save>Done</button></div>
            <button type="button" class="yrm-fw-rule-remove" data-b11-fw-delete-in-modal hidden>Delete Rule</button>
          </dialog>
          <details class="yrm-fw-technical"><summary>Advanced details</summary><pre class="v1-fw-status">@Model.Firewall.Status</pre></details>
        }
      }
      else
      {
      <section class="yrm-flat-panel yrm-certificate-card">
        <div class="yrm-cert-toolbar">
          <h3>Certificates</h3>
          <button type="button" class="button button-secondary" data-yrm-cert-import-open>Import</button>
        </div>
        <details class="yrm-cert-card">
          <summary class="yrm-cert-card-summary">
            <svg class="ui-icon" aria-hidden="true"><use href="#i-shield"/></svg>
            <strong>YRMPanel</strong>
            <span class="tag">@(Model.Certificate.IsCustom ? "Imported" : "System Default")</span>
            <svg class="ui-icon yrm-cert-expand-icon" aria-hidden="true"><use href="#i-chevron"/></svg>
          </summary>
          <div class="yrm-cert-card-details">
            @if (Model.Certificate.Available)
            {
              <dl class="yrm-cert-info-list">
                <div><dt>Issued to</dt><dd>@Model.Certificate.Subject</dd></div>
                @if (!string.Equals(Model.Certificate.Subject, Model.Certificate.Issuer, StringComparison.OrdinalIgnoreCase))
                { <div><dt>Issued by</dt><dd>@Model.Certificate.Issuer</dd></div> }
                <div><dt>Expires</dt><dd>@Model.Certificate.NotAfter.ToString("dd MMM yyyy")</dd></div>
                <div><dt>Status</dt><dd>@(Model.Certificate.NotAfter > DateTime.UtcNow ? "Valid" : "Expired")</dd></div>
                <div class="yrm-cert-fingerprint"><dt>Fingerprint</dt><dd><code>@Model.Certificate.Thumbprint</code></dd></div>
              </dl>
              @if (Model.Certificate.IsCustom)
              {
                <form method="post" asp-page-handler="RestoreCertificate" asp-route-tab="security" asp-route-section="certificates" data-confirm="Restore the original self-signed certificate?">
                  <button type="submit" class="button button-secondary">Restore Default Certificate</button>
                </form>
              }
            }
            else { <p class="muted">Certificate information is available on Linux installations.</p> }
          </div>
        </details>
        <dialog id="yrm-cert-import-dialog" class="panel-modal yrm-cert-import-dialog" aria-labelledby="yrm-cert-import-title">
          <div class="panel-modal-head"><strong id="yrm-cert-import-title">Import Certificate</strong><button type="button" data-yrm-cert-import-close aria-label="Close">×</button></div>
          <form method="post" asp-page-handler="Certificate" asp-route-tab="security" asp-route-section="certificates" enctype="multipart/form-data">
            <div class="yrm-cert-import-fields">
              <label>Certificate (PEM)<input name="certificate" type="file" accept=".crt,.pem" required /></label>
              <label>Private key (PEM)<input name="privateKey" type="file" accept=".key,.pem" required /></label>
            </div>
            <div class="panel-modal-actions"><button type="button" class="button button-secondary" data-yrm-cert-import-close>Cancel</button><button class="button button-primary" type="submit">Import &amp; Activate</button></div>
          </form>
        </dialog>
      </section>
      }
    }
    else if (activeTab == "appearance")
    {

      <section class="yrm-flat-panel settings-wallpaper-card">
        <div class="settings-row-top"><h3>Desktop Wallpaper</h3></div>
        <button type="button" class="yrm-wallpaper-preview-trigger" data-wallpaper-preview-open title="Preview desktop wallpaper" aria-label="View desktop wallpaper">
          <img class="v1-wallpaper-preview" id="wallpaper-preview" src="@(Model.HasWallpaper ? "/wallpaper?v=" + Model.WallpaperVersion : Url.Content("~/images/default-wallpaper.svg"))" alt="Wallpaper preview" />
        </button>
        <dialog class="yrm-wallpaper-lightbox" id="yrm-wallpaper-lightbox" aria-label="Desktop wallpaper preview">
          <button type="button" data-wallpaper-preview-close aria-label="Close wallpaper preview">×</button>
          <img id="yrm-wallpaper-lightbox-image" alt="Desktop wallpaper, full image" />
        </dialog>
        
        <div class="wallpaper-actions">
          <form method="post" asp-page-handler="Wallpaper" asp-route-tab="appearance" enctype="multipart/form-data" id="wallpaper-upload-form" class="wallpaper-upload-actions">
            <input type="file" name="wallpaper" id="wallpaper-select" class="fm-visually-hidden" accept="image/jpeg,image/png,image/webp" required/>
            <button type="button" class="button button-secondary wallpaper-choose" data-file-picker="wallpaper-select">Choose Image</button>
            <button id="wallpaper-apply" type="submit" hidden style="display:none" disabled>Apply</button>
          </form>
          <form method="post" asp-page-handler="ClearWallpaper" asp-route-tab="appearance" class="wallpaper-reset-form">
            <button type="submit" class="button button-secondary">Restore Default</button>
          </form>
        </div>
        <p id="wallpaper-selection-name" class="muted wallpaper-helper">JPEG, PNG or WebP · Up to 8 MB</p>
        @if (Model.WallpaperHistory.Count > 0)
        {
          <div class="yrm-ui-wallpaper-history">
            <h4>Recently Used</h4>
            <div class="yrm-wallpaper-recent-grid">
              @foreach (var history in Model.WallpaperHistory)
              {
                <form method="post" asp-page-handler="RestoreWallpaperHistory" asp-route-tab="appearance">
                  <input type="hidden" name="id" value="@history.Id" />
                  <button type="submit" class="yrm-wallpaper-recent-item" title="Use this wallpaper" aria-label="Apply previously used wallpaper">
                    <img src="@Url.Page("/Settings", "WallpaperHistoryImage", new { id = history.Id })" alt="Previously used wallpaper" loading="eager" decoding="async" />
                  </button>
                </form>
              }
            </div>
          </div>
        }
      </section>
    }
    else if (activeTab == "about")
    {
      var updatePhase = Model.UpdateStatus.State == "running" ? "Updating"
        : Model.LastUpdateCheck?.HasUpdate == true ? "Update Available"
        : Model.UpdateStatus.State == "failed" ? "Update Failed"
        : Model.LastUpdateCheck?.Available == true ? "Up to Date"
        : "Not Checked";
      var badgeClass = Model.UpdateStatus.State == "running" ? "badge-idle"
        : Model.UpdateStatus.State == "failed" ? "badge-failed"
        : Model.LastUpdateCheck?.HasUpdate == true ? "badge-available"
        : Model.LastUpdateCheck?.Available == true ? "badge-ok"
        : "badge-idle";
      var statusMsg = Model.UpdateStatus.State == "running" ? "Updating YRM Panel…"
        : Model.LastUpdateCheck?.HasUpdate == true ? (Model.LastUpdateCheck.Message ?? "A new version is available.")
        : Model.LastUpdateCheck?.Available == true ? "Your installed build is up to date."
        : (Model.UpdateStatus.Message ?? "Updates have not been checked yet.");

      <section class="yrm-flat-panel settings-update-card">
        <div class="settings-row-top"><h3>Updates</h3></div>

        @* Hero card: icon + version + status badge *@
        <div class="yrm-update-hero">
          <div class="yrm-update-hero-icon">
            <svg class="ui-icon"><use href="#i-grid"/></svg>
          </div>
          <div class="yrm-update-hero-body">
            <span class="yrm-update-hero-name">YRMPanel</span>
            <span class="yrm-update-hero-version">@info.PanelVersion.Split('+')[0]</span>
          </div>
          <span class="yrm-update-status-badge @badgeClass">
            <span class="yrm-update-status-dot"></span>
            @updatePhase
          </span>
        </div>

        @* Build hash pill (dev channel only) *@
        @if (Model.UpdateChannel == "dev" && latestBuild.Length >= 8)
        {
          <div class="yrm-update-build-row">
            <span class="yrm-update-build-label">Build</span>
            <code class="yrm-update-build-pill" title="@latestBuild">@(latestBuild[..8])</code>
          </div>
        }

        @* Available version row *@
        @if (Model.LastUpdateCheck?.HasUpdate == true)
        {
          <div class="yrm-update-available">
            <small>Available Version</small>
            <strong>@(Model.LastUpdateCheck.Tag ?? "New development build")</strong>
          </div>
        }

        @* Progress tracker (live update) *@
        <div class="yrm-update-tracker" id="v1-update-progress" role="status" aria-live="polite">
          <div class="yrm-update-tracker-head"><strong id="yrm-update-phase">@updatePhase</strong><span id="yrm-update-percent"></span></div>
          <div id="yrm-update-bar" class="yrm-update-bar" role="progressbar" aria-label="Update download progress" hidden><span id="yrm-update-bar-fill"></span></div>
          <p id="yrm-update-message" class="muted">@statusMsg</p>
          <button type="button" id="yrm-update-reload" class="button button-primary" hidden>Reload Panel</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notice)) { <p class="muted">@Model.Notice</p> }

        @* Action toolbar *@
        <div class="settings-button-row">
          <form method="post" asp-page-handler="CheckUpdate" asp-route-tab="about"><button class="button button-secondary" type="submit">Check Updates</button></form>
          @if (OperatingSystem.IsLinux())
          {
            @if (Model.UpdateStatus.State == "running")
            { <button class="button button-primary" disabled type="button">Updating…</button> }
            else if (Model.LastUpdateCheck?.HasUpdate == true)
            { <form method="post" asp-page-handler="Update" asp-route-tab="about" data-requires-admin="Install the latest YRM Panel release"><button class="button button-primary" data-v1-update type="submit">Update Now</button></form> }
            else { <button class="button button-primary" disabled type="button" title="Check for updates first">Update Now</button> }
          }
          <a class="settings-text-link" href="https://github.com/yuanruoming/yrm-panel/releases" target="_blank" rel="noopener noreferrer" style="margin-left:auto;">View release notes ↗</a>
        </div>

      </section>
    }
  </div>
</div>
