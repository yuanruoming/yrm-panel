@page
@model YrmPanel.Pages.SettingsModel
@{
    ViewData["Title"] = "Settings";
    var sections = new[] {
        ("overview", "Overview", "i-server"),
        ("storage", "Storage", "i-harddrive"),
        ("network", "Network", "i-globe"),
        ("services", "Services", "i-server"),
        ("accounts", "Accounts", "i-settings"),
        ("appearance", "Appearance", "i-folder"),
        ("about", "About & Updates", "i-grid")
    };
    var activeTab = sections.Any(s => s.Item1 == Model.Tab) ? Model.Tab : "overview";
    var info = Model.Info;
    var snapshot = Model.Snapshot;
}
@if (!string.IsNullOrWhiteSpace(Model.Notice))
{ <div class="notice" data-result-notice="@(Model.Notice.StartsWith("Error:") ? "error" : "success")">@Model.Notice</div> }
<div class="server-settings-layout">
  <nav class="server-settings-nav" aria-label="Settings sections">
    <strong class="settings-navigation-title">System settings</strong>
    @foreach (var tab in sections)
    {
      <a class="settings-nav-link @(activeTab == tab.Item1 ? "is-active" : "")"
         asp-page="/Settings" asp-route-tab="@tab.Item1">
        <svg class="ui-icon"><use href="@("#" + tab.Item3)"></use></svg>
        @tab.Item2
      </a>
    }
  </nav>
  <div class="server-settings-content">
    @if (activeTab == "overview")
    {
      <h2>Overview</h2>
      <div class="system-info-grid">
        <section class="surface-card server-info-card"><p class="eyebrow">DEVICE</p><h3>@info.Hostname</h3><p class="muted">@info.OperatingSystem</p></section>
        <section class="surface-card server-info-card"><p class="eyebrow">HARDWARE</p><h3>@info.CpuModel</h3><p class="muted">@info.Processors logical processors · @(info.MemoryBytes > 0 ? (info.MemoryBytes / 1073741824d).ToString("0.0") + " GiB RAM" : "Memory unavailable")</p></section>
        <section class="surface-card server-info-card"><p class="eyebrow">STORAGE</p><h3>@snapshot.Disks.Count disks / filesystems</h3>
          @foreach (var disk in snapshot.Disks)
          { <p class="muted">@disk.Name · @disk.Path · @((disk.UsedBytes / 1073741824d).ToString("0.0")) / @((disk.TotalBytes / 1073741824d).ToString("0.0")) GiB</p> }
        </section>
        <section class="surface-card server-info-card"><p class="eyebrow">NETWORK</p><h3>@(info.Adapters.FirstOrDefault(x => x.Ipv4.Length > 0)?.Ipv4.FirstOrDefault() ?? "Not connected")</h3><p class="muted">@info.Adapters.Count interfaces detected</p></section>
      </div>
    }
    else if (activeTab == "storage")
    {
      <h2>Storage</h2>
      <div class="system-info-grid">
        @foreach (var disk in snapshot.Disks)
        { <section class="surface-card server-info-card"><p class="eyebrow">@disk.Name</p><h3>@disk.Path</h3><p class="muted">@((disk.UsedBytes / 1073741824d).ToString("0.00")) GiB used of @((disk.TotalBytes / 1073741824d).ToString("0.00")) GiB</p><div class="meter-track"><div class="meter-fill cpu" style="width:@(disk.TotalBytes > 0 ? (100.0 * disk.UsedBytes / disk.TotalBytes).ToString("0.0",System.Globalization.CultureInfo.InvariantCulture) : "0")%"></div></div></section> }
      </div>
      <p class="muted">Mount and partition operations are not included in RC4.</p>
    }
    else if (activeTab == "network")
    {
      <h2>Network</h2>
      @foreach (var adapter in info.Adapters)
      { <section class="surface-card server-info-card"><div class="card-header"><h3>@adapter.Name</h3><span class="tag">@adapter.State</span></div>
          <p>IPv4: @(adapter.Ipv4.Length == 0 ? "—" : string.Join(", ", adapter.Ipv4))</p>
          <p>IPv6: @(adapter.Ipv6.Length == 0 ? "—" : string.Join(", ", adapter.Ipv6))</p></section> }
      @if (info.Adapters.Count == 0) { <p class="muted">No network interfaces found.</p> }
    }
    else if (activeTab == "services")
    {
      <h2>System Services</h2>
      <p class="muted">Essential Linux service state (read only).</p>
      <section class="surface-card">
      @foreach (var service in Model.Services)
      {
        <div class="service-row"><span class="status-circle @(service.State == "active" ? "on" : "off")"></span>
          <div class="service-name"><strong>@service.Name</strong><small>@service.Detail</small></div>
          <span class="status-pill @(service.State == "active" ? "is-running" : "is-stopped")">@service.State</span></div>
      }
      </section>
    }
    else if (activeTab == "accounts")
    {
      <h2>Accounts</h2>
      <section class="surface-card server-info-card">
        <p class="eyebrow">LINUX USER</p><h3>@Model.AccountName</h3>
        <p class="muted">YRM PANEL runs as this existing Linux account. Account passwords are handled by Linux PAM; no separate Panel password is stored on Linux.</p>
        <p class="muted">Multi-user management is planned for a future version.</p>
      </section>
    }
    else if (activeTab == "appearance")
    {
      <h2>Appearance</h2>
      <section class="surface-card server-info-card">
        <h3>Desktop wallpaper</h3>
        <div class="wallpaper-preview" style="background-image:url('@(Model.HasWallpaper ? "/wallpaper?v=" + Model.WallpaperVersion : Url.Content("~/images/default-wallpaper.svg"))')"></div>
        <form method="post" asp-page-handler="Wallpaper" asp-route-tab="appearance" enctype="multipart/form-data" id="wallpaper-upload-form" class="form-stack">
          <label for="wallpaper-select">Choose wallpaper (JPEG, PNG or WebP; up to 8 MB)</label>
          <input type="file" name="wallpaper" id="wallpaper-select" accept="image/jpeg,image/png,image/webp" required/>
          <noscript><button class="button button-primary">Upload and apply</button></noscript>
        </form>
        @if (Model.HasWallpaper) { <form method="post" asp-page-handler="ClearWallpaper" asp-route-tab="appearance"><button type="submit" class="button button-secondary">Restore default wallpaper</button></form> }
        <p class="muted">The login background is a system-wide built-in design and does not reveal a user's personal desktop wallpaper.</p>
      </section>
    }
    else if (activeTab == "about")
    {
      <h2>About &amp; Updates</h2>
      <section class="surface-card server-info-card">
        <p class="eyebrow">YRM PANEL</p><h3>@info.PanelVersion</h3>
        <p class="muted">Linux server management · ASP.NET Core 10</p>
        <p>Listening: <code>@info.Endpoint</code></p>
        <p><a href="https://github.com/yuanruoming/yrm-panel" target="_blank" rel="noopener noreferrer">Source and releases ↗</a></p>
      </section>
      <section class="surface-card server-info-card">
        <div class="card-header"><h3>System Update</h3><span class="tag">Dev channel</span></div>
        <p class="muted">Status: <strong>@Model.UpdateStatus.State</strong> — @Model.UpdateStatus.Message</p>
        <div class="panel-modal-actions">
          <form method="post" asp-page-handler="CheckUpdate" asp-route-tab="about"><button class="button button-secondary" type="submit">Check updates</button></form>
          @if (OperatingSystem.IsLinux())
          { <form method="post" asp-page-handler="Update" asp-route-tab="about" data-requires-admin="Install the latest YRM Panel release"><button class="button button-primary" type="submit">Update now</button></form> }
        </div>
        <p class="muted">Only YRM Panel files are updated; Docker, Samba and user data are preserved.</p>
      </section>
    }
  </div>
</div>
