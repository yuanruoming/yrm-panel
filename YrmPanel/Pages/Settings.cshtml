@page
@model YrmPanel.Pages.SettingsModel
@{
    ViewData["Title"] = "Settings";
    var sections = new[] {
        ("overview", "Overview", "i-server"),
        ("storage", "Storage", "i-harddrive"),
        ("network", "Network", "i-globe"),
        ("ddns", "Dynamic DNS", "i-globe"),
        ("sharing", "File Sharing", "i-folder"),
        ("services", "Services", "i-server"),
        ("accounts", "Accounts", "i-settings"),
        ("security", "Security", "i-shield"),
        ("appearance", "Appearance", "i-folder"),
        ("about", "About & Updates", "i-grid")
    };
    var activeTab = sections.Any(s => s.Item1 == Model.Tab) ? Model.Tab : "overview";
    var info = Model.Info;
    var snapshot = Model.Snapshot;
}
@if (!string.IsNullOrWhiteSpace(Model.Notice) && Model.Tab != "about")
{ <div class="notice" data-result-notice="@(Model.Notice.StartsWith("Error:") ? "error" : "success")">@Model.Notice</div> }
<div class="server-settings-layout settings-rc41">
  <nav class="server-settings-nav" aria-label="Settings sections">
    <strong class="settings-navigation-title">Settings</strong>
    @foreach (var tab in sections)
    {
      <a class="settings-nav-link @(activeTab == tab.Item1 ? "is-active" : "")"
         asp-page="/Settings" asp-route-tab="@tab.Item1">
        <svg class="ui-icon"><use href="@("#" + tab.Item3)"></use></svg>
        @tab.Item2
      </a>
    }
  </nav>
  <div class="server-settings-content">
    @if (activeTab == "overview")
    {
      <div class="settings-section-heading"><h2>Overview</h2><p>Your Linux server at a glance.</p></div>
      <section class="surface-card settings-device-card">
        <div class="settings-device-avatar"><svg class="ui-icon"><use href="#i-server"/></svg></div>
        <div><p class="eyebrow">DEVICE</p><h3>@info.Hostname</h3><p class="muted">@info.OperatingSystem</p></div>
      </section>
      <div class="settings-summary-grid">
        <section class="surface-card"><p class="eyebrow">CPU</p><h3>@info.Processors cores</h3><p class="muted settings-clip">@info.CpuModel</p></section>
        <section class="surface-card"><p class="eyebrow">MEMORY</p><h3>@(info.MemoryBytes > 0 ? (info.MemoryBytes / 1073741824d).ToString("0.0") + " GiB" : "Unavailable")</h3><p class="muted">Installed RAM</p></section>
        <section class="surface-card"><p class="eyebrow">STORAGE</p><h3>@snapshot.Disks.Count</h3><p class="muted">Detected filesystems</p></section>
        <section class="surface-card"><p class="eyebrow">NETWORK</p><h3 class="settings-clip">@(info.Adapters.FirstOrDefault(x => x.Ipv4.Length > 0 && !Model.IsVirtualAdapter(x.Name))?.Ipv4.FirstOrDefault() ?? "Unavailable")</h3><p class="muted">Primary IPv4</p></section>
      </div>
    }
    else if (activeTab == "storage")
    {
      <div class="settings-section-heading"><h2>Storage</h2><p>Volumes and physical disks managed by Ubuntu Server.</p></div>
      // Filesystem identity comes from lsblk UUID, while current mount data
      // and capacity come from the host. Do not invent a parallel volume DB.
        var volumes = Model.StorageDevices
          .Where(d => d.FileSystem.Length > 0 && d.Uuid.Length > 0 &&
              !d.MountPoint.StartsWith("/boot", StringComparison.Ordinal) &&
              !d.MountPoint.StartsWith("/var/", StringComparison.Ordinal))
          .GroupBy(d => d.Uuid, StringComparer.Ordinal).Select(g => g.First())
          .OrderByDescending(d => d.MountPoint == "/")
          .ThenBy(d => d.MountPoint.Length == 0)
          .ThenBy(d => d.Path, StringComparer.Ordinal).ToArray();
      var volumeNumber = 0;
      <section class="v1-settings-panel yrm-storage-section yrm-b9-volume-section">
        <div class="settings-row-top"><div><h3>Volumes</h3><p class="muted">Filesystem capacity and mount locations. Share individual folders in Files.</p></div></div>
        <div class="yrm-b9-volume-grid">
          @foreach (var volume in volumes)
          {
            volumeNumber++;
            var capacity = snapshot.Disks.FirstOrDefault(d => d.Path == volume.MountPoint);
            var isSystem = volume.MountPoint == "/";
            <article class="yrm-b9-volume-card">
              <div class="yrm-b9-volume-head"><div><small class="eyebrow">Volume @volumeNumber · @(isSystem ? "System" : "Storage")</small><h3>@(volume.MountPoint.Length > 0 ? volume.MountPoint : "Not mounted")</h3></div><span class="tag">@(volume.MountPoint.Length == 0 ? "Offline" : "Mounted")</span></div>
              @if (capacity is not null && capacity.TotalBytes > 0)
              {
                <div class="meter-track"><div class="meter-fill cpu" style="width:@((100.0 * capacity.UsedBytes / capacity.TotalBytes).ToString("0.0",System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
                <p class="muted">@((capacity.UsedBytes / 1073741824d).ToString("0.0")) GiB used of @((capacity.TotalBytes / 1073741824d).ToString("0.0")) GiB</p>
              }
              else { <p class="muted">@volume.Size · @volume.FileSystem</p> }
              <small class="yrm-b9-volume-meta">@volume.Name · @volume.FileSystem · UUID: @volume.Uuid</small>
              @if (volume.MountPoint.Length == 0 && volume.CanMount)
              {
                <form method="post" asp-page-handler="Mount" asp-route-tab="storage" data-requires-admin="Mount existing Linux filesystem" class="yrm-mount-form">
                  <input type="hidden" name="uuid" value="@volume.Uuid" />
                  <label>Mount location<input name="mountPath" required value="@Model.SuggestedMountPath(volume)" /></label>
                  <label class="v1-check"><input type="checkbox" name="automatic" value="true" checked /> Mount on startup</label>
                  <button class="button button-primary" type="submit">Mount</button>
                </form>
              }
              else if (volume.ManagedMount && !isSystem && volume.MountPoint.Length > 0)
              {
                <div class="yrm-b9-volume-action">
                  @if (!Model.Sharing.Available)
                  { <small class="muted">Cannot verify SMB sharing; unmount is unavailable.</small> }
                  else if (Model.HasVolumeShares(volume.MountPoint))
                  { <small class="muted">Stop sharing folders on this volume before unmounting.</small> }
                  else
                  {
                    <form method="post" asp-page-handler="Unmount" asp-route-tab="storage" data-requires-admin="Unmount volume" data-confirm="Unmount @volume.MountPoint? Open files or active services may prevent this operation.">
                      <input type="hidden" name="mountPath" value="@volume.MountPoint" />
                      <input type="hidden" name="uuid" value="@volume.Uuid" />
                      <button class="button button-secondary" type="submit">Unmount</button>
                    </form>
                  }
                </div>
              }
              else if (!isSystem && volume.MountPoint.Length > 0)
              { <small class="muted">Mount managed outside YRM Panel. Read-only status.</small> }
            </article>
          }
        </div>
        @if (volumes.Length == 0) { <p class="muted">No recognized filesystems found.</p> }
      </section>
      <section class="v1-settings-panel yrm-storage-section yrm-b9-physical-section">
        <div class="settings-row-top"><div><h3>Physical Disks</h3><p class="muted">Physical devices, partitions and filesystem identification. No duplicate volume actions.</p></div></div>
        @foreach (var disk in Model.StorageDevices.Where(x => x.Type == "disk"))
        {
          <article class="yrm-disk-card">
            <div class="yrm-disk-title"><svg class="ui-icon"><use href="#i-harddrive"/></svg><div><strong>@disk.Name</strong><small>@disk.Path · @disk.Size @(disk.Removable ? "· Removable" : "")</small></div></div>
            @foreach (var part in Model.StorageDevices.Where(x => x.ParentPath == disk.Path).Prepend(disk)
                .Where(x => (x.Type == "part" || x.Type == "disk") && (x != disk || x.FileSystem.Length > 0) && !Model.IsSmallUnformatted(x)))
            {
              <div class="yrm-partition-card yrm-b9-physical-partition">
                <strong>@part.Name · @(part.Label.Length > 0 ? part.Label : (part.FileSystem.Length > 0 ? part.FileSystem : "No filesystem"))</strong>
                <small>@part.Size · @(part.MountPoint.Length > 0 ? "Mounted at " + part.MountPoint : "Not mounted")</small>
                @if (part.Uuid.Length > 0) { <small>UUID: @part.Uuid</small> }
                @if (part.FileSystem.Length == 0 && part.Type == "part" && !part.ReadOnly && !part.Removable &&
                     part.MountPoint.Length == 0 && part.Uuid.Length == 0 &&
                     Model.StorageDevices.Count(x => x.ParentPath == disk.Path) == 1 &&
                     disk.MountPoint.Length == 0 && !disk.ReadOnly && !disk.Removable)
                {
                  <details class="yrm-disk-initialize"><summary class="button button-secondary">Complete Incomplete Setup</summary>
                    <form method="post" asp-page-handler="CompleteDisk" asp-route-tab="storage"
                          data-requires-admin="Format verified empty partition" data-confirm="This will FORMAT the selected empty partition. Continue?">
                      <input type="hidden" name="partitionPath" value="@part.Path" />
                      <p class="yrm-storage-warning">Formats only a verified blank partition. Existing filesystems are refused.</p>
                      <label>Confirm exactly: <code>FORMAT @part.Path</code><input name="confirmation" required autocomplete="off" placeholder="FORMAT @part.Path" /></label>
                      <button type="submit" class="button button-danger">Verify &amp; Complete Setup</button>
                    </form>
                  </details>
                }
              </div>
            }
            @if (Model.StorageDevices.Any(x => x.ParentPath == disk.Path && Model.IsSmallUnformatted(x)))
            { <details class="yrm-small-partitions"><summary>System / reserved partitions</summary>
                @foreach (var reserved in Model.StorageDevices.Where(x => x.ParentPath == disk.Path && Model.IsSmallUnformatted(x)))
                { <p class="muted">@reserved.Name · @reserved.Size · Reserved / unformatted</p> }
              </details> }
            @if (!Model.StorageDevices.Any(x => x.ParentPath == disk.Path) && disk.FileSystem.Length == 0 &&
                 !disk.ReadOnly && !disk.Removable && disk.MountPoint.Length == 0 && disk.Uuid.Length == 0)
            {
              <details class="yrm-disk-initialize"><summary class="button button-secondary">Initialize Empty Disk</summary>
                <form method="post" asp-page-handler="InitializeDisk" asp-route-tab="storage"
                      data-requires-admin="Permanently erase selected blank disk" data-confirm="This will erase the selected disk and cannot be undone. Continue?">
                  <input type="hidden" name="diskPath" value="@disk.Path" />
                  <p class="yrm-storage-warning"><strong>Destructive:</strong> Creates GPT and ext4 only on a verified empty disk. Existing signatures are refused.</p>
                  <label>Confirm exactly: <code>ERASE @disk.Path</code><input name="confirmation" required autocomplete="off" placeholder="ERASE @disk.Path" /></label>
                  <button type="submit" class="button button-danger">Erase &amp; Initialize</button>
                </form>
              </details>
            }
          </article>
        }
        @if (!Model.StorageDevices.Any(x => x.Type == "disk")) { <p class="muted">No physical disks reported by lsblk.</p> }
        <p class="muted yrm-storage-note">Ubuntu retains the actual filesystems and /etc/fstab entries even when the Panel is removed.</p>
      </section>
    }
    else if (activeTab == "network")
    {
      <div class="settings-section-heading"><h2>Network</h2><p>Read-only addresses from your Linux network interfaces.</p></div>
      <div class="settings-stack">
        @foreach (var adapter in info.Adapters.Where(x => !Model.IsVirtualAdapter(x.Name)))
        {
          <section class="surface-card settings-network-card">
            <div class="settings-row-top"><div><h3>@adapter.Name</h3><small class="muted">Network interface</small></div><span class="tag">@adapter.State</span></div>
            @foreach (var ipv4 in adapter.Ipv4)
            {
              <div class="settings-address-row"><span>IPv4</span><code>@ipv4</code><button class="mini-button" type="button" data-copy-address="@ipv4" title="Copy IPv4" aria-label="Copy IPv4">⧉</button></div>
            }
            @foreach (var ipv6 in adapter.Ipv6.Where(x => !Model.IsLinkLocalIpv6(x)))
            {
              <div class="settings-address-row"><span>Global IPv6</span><code>@ipv6</code><button class="mini-button" type="button" data-copy-address="@ipv6" title="Copy IPv6" aria-label="Copy IPv6">⧉</button></div>
            }
            @if (adapter.Ipv4.Length == 0 && adapter.Ipv6.Length == 0) { <p class="muted">No assigned addresses.</p> }
            @if (adapter.Ipv6.Any(Model.IsLinkLocalIpv6))
            {
              <details class="settings-secondary-addresses"><summary>Link-local addresses</summary>
                @foreach (var ip in adapter.Ipv6.Where(Model.IsLinkLocalIpv6))
                { <div class="settings-address-row"><span>IPv6</span><code>@ip</code><button class="mini-button" type="button" data-copy-address="@ip" title="Copy address">⧉</button></div> }
              </details>
            }
          </section>
        }
        @if (info.Adapters.Any(x => Model.IsVirtualAdapter(x.Name)))
        {
          <details class="settings-network-secondary"><summary>Virtual &amp; secondary interfaces (@info.Adapters.Count(x => Model.IsVirtualAdapter(x.Name)))</summary>
            @foreach (var adapter in info.Adapters.Where(x => Model.IsVirtualAdapter(x.Name)))
            {
              <div class="settings-virtual-row"><div><strong>@adapter.Name</strong><small>@adapter.State</small></div>
                <div class="settings-virtual-addresses">
                  @foreach (var ip in adapter.Ipv4.Concat(adapter.Ipv6.Where(x => !Model.IsLinkLocalIpv6(x))))
                  { <code>@ip</code> }
                  @if (adapter.Ipv4.Length == 0 && !adapter.Ipv6.Any(x => !Model.IsLinkLocalIpv6(x))) { <small class="muted">No assigned addresses</small> }
                </div>
              </div>
            }
          </details>
        }
        @if (info.Adapters.Count == 0) { <p class="muted">No network interfaces detected.</p> }
      </div>
    }
    else if (activeTab == "ddns")
    {
      <div class="settings-section-heading"><h2>Dynamic DNS</h2><p>Automatically keep your hostnames in sync.</p></div>
      <section class="v1-settings-panel yrm-ddns-list">
        <div class="settings-row-top"><h3>DDNS Profiles</h3><div class="yrm-b9-ddns-heading-actions"><span class="muted">@(Model.DdnsProfiles.Select(x => x.Provider + "|" + x.Hostname.ToLowerInvariant()).Distinct().Count()) configured</span><button class="button button-primary" type="button" data-b9-ddns-add>+ Add Provider</button></div></div>
        @foreach (var group in Model.DdnsProfiles.GroupBy(p => new { Provider = p.Provider.ToLowerInvariant(), Hostname = p.Hostname.ToLowerInvariant() }))
        {
          var active = group.Any(p => p.Enabled && p.IpSource != "disabled");
          var failed = group.Any(p => p.LastStatus.StartsWith("Failed", StringComparison.OrdinalIgnoreCase));
          var warning = group.Any(p => p.VerifyDns && (p.Verification == "DNS lookup unavailable" || p.Verification.StartsWith("Waiting", StringComparison.OrdinalIgnoreCase)));
          var groupStatus = !active ? "Disabled" : failed ? "Failed" : warning ? "DNS unverified" : group.Any(p => p.LastStatus is "Updated" or "Unchanged" or "IP unchanged") ? "Normal" : "Not checked";
          <div class="yrm-ddns-group" data-b9-ddns-provider="@group.Key.Provider" data-b9-ddns-hostname="@group.Key.Hostname">
            <div class="yrm-ddns-group-head">
              <div><strong>@(char.ToUpperInvariant(group.Key.Provider[0]) + group.Key.Provider.Substring(1))</strong><div class="muted">@group.Key.Hostname</div></div>
              <span class="tag" data-b9-ddns-status>@groupStatus</span>
            </div>
            <div class="yrm-ddns-records">
              @foreach (var profile in group.OrderBy(p => p.RecordType == "A" ? 0 : 1))
              {
                <div class="yrm-ddns-record" data-b9-ddns-record="@profile.Id">
                  <div>
                    <strong>@(profile.RecordType == "A" ? "IPv4" : "IPv6") · @(profile.Enabled && profile.IpSource != "disabled" ? "Automatic monitoring" : "Disabled")</strong>
                    <div class="muted" data-b9-ddns-ip>@(profile.IpSource == "disabled" ? "Disabled" : profile.LastIp.Length > 0 ? profile.LastIp : "Not checked")</div>
                    <small class="muted" data-b9-ddns-checked>@(profile.LastRun is { } last ? "Checked " + last.ToLocalTime().ToString("dd MMM yyyy HH:mm") : "Not checked yet")</small>
                    <small class="yrm-inline-error" data-b9-ddns-error hidden="@(!profile.LastStatus.StartsWith("Failed", StringComparison.OrdinalIgnoreCase))">@(profile.LastStatus.StartsWith("Failed", StringComparison.OrdinalIgnoreCase) ? profile.LastStatus : "")</small>
                  </div>
                  <div class="yrm-ddns-record-actions">
                    <button type="button" class="button button-secondary" data-yrm-ddns-edit="yrm-ddns-edit-@profile.Id">Edit</button>
                    <form method="post" asp-page-handler="DdnsDelete" asp-route-tab="ddns" data-confirm="Remove this DDNS profile? Your provider's DNS record will remain unchanged."><input type="hidden" name="id" value="@profile.Id"/><button class="button button-secondary">Remove</button></form>
                  </div>
                </div>
              }
            </div>
            <div class="v1-row">
              <form method="post" asp-page-handler="DdnsGroupCheck" asp-route-tab="ddns" data-b9-ddns-check>
                <input type="hidden" name="hostname" value="@group.Key.Hostname"/>
                <input type="hidden" name="provider" value="@group.Key.Provider"/>
                <button class="button button-secondary" type="submit">Check Now</button>
              </form>
              <small class="muted">Every @(group.Min(p => p.IntervalMinutes)) min</small>
            </div>
          </div>
        }
        @if (Model.DdnsProfiles.Count == 0) { <p class="muted">No DDNS profiles yet.</p> }
      </section>
      @foreach (var profile in Model.DdnsProfiles)
      {
        <dialog id="yrm-ddns-edit-@profile.Id" class="yrm-ddns-editor" aria-label="Edit DDNS profile">
          <form method="post" asp-page-handler="DdnsEdit" asp-route-tab="ddns" autocomplete="off">
            <h3>Edit @(profile.RecordType == "A" ? "IPv4" : "IPv6") · @profile.Provider</h3>
            <input type="hidden" name="id" value="@profile.Id" />
            <label>Profile name<input name="name" required maxlength="50" value="@profile.Name" autocomplete="off" /></label>
            <label>Hostname<input name="hostname" required value="@profile.Hostname" autocomplete="off" /></label>
            @if (profile.Provider == "dynu")
            { <label>Dynu username<input name="username" value="@profile.Username" required autocomplete="off" /></label> }
            else { <input type="hidden" name="username" value="@profile.Username"/> }
            <label>@(profile.Provider == "cloudflare" ? "Cloudflare API Token" : profile.Provider == "dynu" ? "IP Update Password" : "API credential")
              <input name="token" type="password" value="" autocomplete="new-password" placeholder="Leave blank to keep existing credential" /><button type="button" class="yrm-b9-secret-toggle" data-b9-secret-toggle>Show</button>
              <small>Existing credentials are retained when this field is empty.</small>
            </label>
            <label>IP address source
              <select name="ipSource" data-yrm-ip-source>
                <option value="public" selected="@(profile.IpSource == "public")">Automatic public IP</option>
                <option value="interface" selected="@(profile.IpSource == "interface")">Network interface IP</option>
                <option value="manual" selected="@(profile.IpSource == "manual")">Manual IP</option>
                <option value="disabled" selected="@(profile.IpSource == "disabled")">Disabled</option>
              </select>
            </label>
            <label data-yrm-source="manual" hidden="@(profile.IpSource != "manual")">Manual IP
              <input name="manualIp" value="@profile.ManualIp" placeholder="IPv4 or IPv6 address" autocomplete="off" />
            </label>
            <label data-yrm-source="interface" hidden="@(profile.IpSource != "interface")">Network interface
              <select name="interfaceName">
                <option value="">Select interface</option>
                @foreach (var item in Model.DdnsNetworkInterfaces)
                { <option value="@item" selected="@(profile.InterfaceName == item)">@item</option> }
              </select>
              <small>This uses the interface's own IP, not its router's external IP.</small>
            </label>
            @if (profile.Provider == "custom")
            {
              <details>
                <summary>Custom API settings</summary>
                <label>HTTPS URL<input name="apiUrl" required value="@profile.UrlTemplate" autocomplete="off" /></label>
                <label>HTTP method<select name="httpMethod">
                    @foreach (var item in new[] { "GET", "POST", "PUT", "PATCH" })
                    { <option value="@item" selected="@(profile.HttpMethod == item)">@item</option> }
                </select></label>
                <label>Authentication<select name="authType">
                    @foreach (var item in new[] { "none", "basic", "bearer", "header" })
                    { <option value="@item" selected="@(profile.AuthType == item)">@item</option> }
                </select></label>
                <label>Header name<input name="headerName" value="@profile.HeaderName" /></label>
                <label>JSON body<textarea name="bodyTemplate" rows="3">@profile.BodyTemplate</textarea></label>
                <label>Response mode<select name="responseMode">
                    @foreach (var item in new[] { "codes", "json", "http" })
                    { <option value="@item" selected="@(profile.ResponseMode == item)">@item</option> }
                </select></label>
                <label>Success codes<input name="successCodes" value="@profile.SuccessCodes" /></label>
                <label>Unchanged codes<input name="unchangedCodes" value="@profile.UnchangedCodes" /></label>
                <label>Error codes<input name="errorCodes" value="@profile.ErrorCodes" /></label>
                <label>JSON property<input name="jsonProperty" value="@profile.JsonProperty" /></label>
                <label>Expected JSON value<input name="jsonExpected" value="@profile.JsonExpected" /></label>
              </details>
            }
            <label>Check interval (minutes)<input type="number" name="intervalMinutes" min="5" max="1440" required value="@profile.IntervalMinutes" /></label>
            <label class="v1-check"><input name="enabled" type="checkbox" value="true" checked="@profile.Enabled" /> Enable automatic updates</label>
            <div class="panel-modal-actions">
              <button class="button button-secondary" type="button" data-yrm-ddns-edit-close>Cancel</button>
              <button class="button button-primary" type="submit">Save Changes</button>
            </div>
          </form>
        </dialog>
      }
      <dialog id="yrm-b9-ddns-add" class="yrm-ddns-editor yrm-b9-ddns-dialog" aria-label="Add DDNS provider">
        <div class="panel-modal-head"><strong>Add DDNS Provider</strong><button type="button" data-b9-ddns-cancel aria-label="Close">×</button></div>
          <form method="post" asp-page-handler="DdnsAdd" asp-route-tab="ddns" id="yrm-ddns-new-form">
            <label>Provider template
              <select id="yrm-ddns-provider-preset"><option value="dynu4">Dynu · IPv4</option><option value="dynu6">Dynu · IPv6</option><option value="cloudflare4">Cloudflare · IPv4</option><option value="cloudflare6">Cloudflare · IPv6</option><option value="custom">Custom HTTPS API</option></select>
            </label>
            <p id="yrm-ddns-provider-note" class="muted">Dynu: enter your hostname, username and IP Update Password.</p>
            <div class="v1-grid">
              <label>Profile name<input name="name" required maxlength="50" placeholder="Dynu IPv4" /></label>
              <label>Hostname<input name="hostname" required placeholder="nas.example.com" /></label>
            </div>
            <div class="v1-grid" data-ddns-technical>
              <label>Record type<select name="recordType"><option>A</option><option>AAAA</option></select></label>
              <label>Method<select name="httpMethod"><option>GET</option><option>POST</option><option>PUT</option><option>PATCH</option></select></label>
            </div>
            <label data-ddns-technical>Provider HTTPS API URL<input name="urlTemplate" type="text" required placeholder="https://api.example.com/update?hostname={hostname}&amp;myip={ip}" spellcheck="false" /></label>
            <div class="v1-grid">
              <label>Authentication
                <select name="authType" id="yrm-ddns-auth"><option value="basic">HTTP Basic</option><option value="bearer">Bearer token</option><option value="header">Custom header</option><option value="none">None</option></select>
              </label>
              <label data-ddns-auth="basic">Username<input name="username" autocomplete="new-password" placeholder="Dynu username" /></label>
            </div>
            <div class="v1-grid">
              <label data-ddns-auth="header">Header name<input name="headerName" value="Authorization" placeholder="Authorization" /></label>
              <label><span id="yrm-ddns-secret-label">Credential / API token</span><input name="token" type="password" autocomplete="new-password" placeholder="" /><button type="button" class="yrm-b9-secret-toggle" data-b9-secret-toggle>Show</button></label>
            </div>
            <label data-ddns-technical>JSON body (optional)<textarea rows="3" name="bodyTemplate" placeholder='{"type":"A","name":"{hostname}","content":"{ip}"}'></textarea></label>
            <details class="yrm-ddns-advanced"><summary>Advanced settings</summary>
              <label>Custom public IP detection URL (optional)
                <input name="detectionUrl" type="url" placeholder="Automatic (two HTTPS detection sources)" spellcheck="false" />
                <small>Leave empty to detect IPv4/IPv6 automatically. A custom URL must return only a public IP address.</small>
              </label>
              <label>Response validation
                <select name="responseMode" id="yrm-ddns-response-mode"><option value="codes">Text response codes</option><option value="json">JSON property</option><option value="http">HTTP 2xx only</option></select>
              </label>
              <div data-ddns-response="codes" class="v1-grid">
                <label>Success codes<input name="successCodes" value="good" placeholder="good" /></label>
                <label>Unchanged codes<input name="unchangedCodes" value="nochg" placeholder="nochg" /></label>
                <label>Error codes<input name="errorCodes" value="badauth,nohost,notfqdn,unknown,servererror,911" /></label>
              </div>
              <div data-ddns-response="json" class="v1-grid" hidden>
                <label>JSON property path<input name="jsonProperty" value="success" placeholder="success" /></label>
                <label>Expected value<input name="jsonExpected" value="true" placeholder="true" /></label>
              </div>
              <label class="v1-check"><input type="checkbox" name="verifyDns" value="true" checked /> Verify A / AAAA DNS record after updating</label>
              <input type="hidden" name="verifyDns" value="false" />
              <div class="v1-grid"><label>Update interval (minutes)<input name="intervalMinutes" type="number" min="5" max="1440" value="10" /></label></div>
              <p class="muted">Variables: {hostname}, {ip}, {ipv4}, {ipv6}. DNS caches or proxies may temporarily show a different IP.</p>
            </details>
            <input type="hidden" name="provider" id="yrm-ddns-provider" value="dynu" />
            <input type="hidden" name="successContains" value="" />
            <div class="panel-modal-actions"><button class="button button-secondary" type="button" data-b9-ddns-cancel>Cancel</button><button class="button button-primary" type="submit">Save Provider</button></div>
          </form>
      </dialog>
    }
    else if (activeTab == "sharing")
    {
      <div class="settings-section-heading"><h2>File Sharing</h2><p>SMB shares configured on this server.</p></div>
      <section class="surface-card settings-simple-card">
        @if (Model.Sharing.Available)
        {
          <div class="settings-row-top"><div><p class="eyebrow">SMB ACCOUNT</p><h3>@Model.Sharing.Account</h3></div><span class="tag">@(Model.Sharing.AccountConfigured ? "Ready" : "Not configured")</span></div>
          <p class="muted">@(Model.Sharing.AccountConfigured ? "SMB authentication is configured." : "Your SMB password will be requested the first time you share a folder.")</p>
          <div class="settings-share-list">
          @foreach (var share in Model.Sharing.Shares)
          { <div class="settings-share-row"><div><strong>@share.Name</strong><small>@share.Path</small></div><span>@(share.ReadOnly ? "Read only" : "Read / write")</span></div> }
          @if (Model.Sharing.Shares.Count == 0) { <p class="muted">No folders are currently shared.</p> }
          </div>
          <a class="button button-secondary" asp-page="/Files" asp-route-path="@("@folders")">Open Files</a>
        }
        else { <p class="muted">@Model.Sharing.Message</p> }
      </section>
    }
    else if (activeTab == "services")
    {
      <div class="settings-section-heading"><h2>System Services</h2><p>Basic Linux service status, read-only.</p></div>
      <section class="surface-card settings-simple-card">
        @foreach (var service in Model.Services)
        {
          <div class="service-row"><span class="status-circle @(service.State == "active" ? "on" : "off")"></span>
            <div class="service-name"><strong>@service.Name</strong><small>@service.Detail</small></div>
            <span class="status-pill @(service.State == "active" ? "is-running" : "is-stopped")">@service.State</span></div>
        }
      </section>
    }
    else if (activeTab == "accounts")
    {
      <div class="settings-section-heading"><h2>Accounts</h2><p>Linux identity used by YRM PANEL.</p></div>
      <section class="surface-card settings-simple-card">
        <p class="eyebrow">CURRENT LINUX USER</p><h3>@Model.AccountName</h3>
        <p class="muted">Linux PAM handles login. YRM PANEL runs with the permissions of this account, and asks for sudo authorization only for administrative operations.</p>
      </section>
    }
    else if (activeTab == "security")
    {
      <div class="settings-section-heading"><h2>Security</h2><p>Firewall rules and the Panel HTTPS identity.</p></div>
      <nav class="yrm-subtabs" aria-label="Security sections">
        <a class="yrm-subtab @(Model.SecuritySection == "firewall" ? "is-active" : "")" asp-page="/Settings" asp-route-tab="security" asp-route-section="firewall">Firewall</a>
        <a class="yrm-subtab @(Model.SecuritySection == "certificates" ? "is-active" : "")" asp-page="/Settings" asp-route-tab="security" asp-route-section="certificates">Certificates</a>
      </nav>
      @if (Model.SecuritySection == "firewall")
      {
      <section class="v1-settings-panel">
        <div class="settings-row-top"><h3>Firewall</h3>
          @if (Model.Firewall.Available) { <span class="tag">@(Model.Firewall.Active ? "Active" : "Inactive")</span> }
          else { <span class="tag">Unavailable</span> }
        </div>
        @if (!Model.Firewall.Available)
        {
          <p>UFW is unavailable. Install or repair UFW before editing firewall rules.</p>
          <details><summary>Technical details</summary><pre class="v1-fw-status">@Model.Firewall.Status</pre></details>
        }
        else
        {
          @if (!string.IsNullOrWhiteSpace(Model.Firewall.PendingConfirmation))
          {
            <div class="yrm-firewall-pending">
              <strong>Confirm the server is reachable</strong>
              <p>UFW was enabled. Confirm within 120 seconds to prevent automatic rollback.</p>
              <form method="post" asp-page-handler="FirewallConfirm" asp-route-tab="security" asp-route-section="firewall">
                <input type="hidden" name="nonce" value="@Model.Firewall.PendingConfirmation" />
                <button class="button button-primary" type="submit">Keep Firewall Enabled</button>
              </form>
            </div>
          }
          <form id="v1-firewall-form" method="post" asp-page-handler="Firewall" asp-route-tab="security" asp-route-section="firewall" data-requires-admin="Save &amp; Apply firewall rule changes">
            <div class="yrm-fw-state">
              <div><strong>Firewall status</strong><small>Host firewall (UFW)</small></div>
              <select name="firewallEnabled" aria-label="Firewall status">
                <option value="true" selected="@Model.Firewall.Active">Active</option>
                <option value="false" selected="@(!Model.Firewall.Active)">Inactive</option>
              </select>
            </div>
            <div class="yrm-fw-header"><span>Scope</span><span>Action</span><span>Ports</span><span>Protocol</span><span>Source IP / CIDR</span><span></span></div>
            <div id="v1-firewall-rules" data-initial="@(System.Text.Json.JsonSerializer.Serialize(Model.Firewall.Rules.Select(x=>new {scope=x.Scope,action=x.Action,port=x.Port,protocol=x.Protocol,source=x.Source})))"></div>
            <input type="hidden" id="v1-fw-json" name="rulesJson" value="[]" />
            <div class="v1-row"><button class="button button-secondary" data-fw-add type="button">+ Add Rule</button><span id="v1-fw-dirty" class="muted"></span></div>
            <div class="v1-row"><button class="button button-primary" type="submit">Save &amp; Apply</button></div>
          </form>
          <details class="yrm-firewall-advanced"><summary>Advanced details</summary>
            <pre class="v1-fw-status">@Model.Firewall.Status</pre>
            <p>Ports: 80,443 or 20-442. Source: any, a single IP or CIDR (192.168.0.0/24). Docker filtering currently supports IPv4 with compatible iptables only.</p>
            <p>New UFW activation includes temporary remote-access protection and rolls back unless confirmed.</p>
          </details>
        }
      </section>
      }
      else
      {
      <section class="v1-settings-panel yrm-certificate-card">
        <div class="settings-row-top"><h3>HTTPS Certificate</h3><span class="tag">@(Model.Certificate.IsCustom ? "Imported" : "System default")</span></div>
        @if (Model.Certificate.Available)
        {
          <div class="yrm-cert-summary">
            <svg class="ui-icon"><use href="#i-shield"/></svg>
            <div class="yrm-cert-title"><strong>YRM PANEL HTTPS</strong>
              <small>@(Model.Certificate.IsCustom ? "Imported certificate" : "Default self-signed certificate")</small></div>
            <span class="tag">@(Model.Certificate.NotAfter > DateTime.UtcNow ? "Valid" : "Expired")</span>
          </div>
          <div class="yrm-cert-expiry"><span class="muted">Expires</span><strong>@Model.Certificate.NotAfter.ToString("dd MMM yyyy")</strong></div>
          <details class="yrm-cert-technical"><summary>View certificate details</summary>
            <dl class="yrm-cert-details">
              <div><dt>Issued to</dt><dd>@Model.Certificate.Subject</dd></div>
              <div><dt>Issuer</dt><dd>@Model.Certificate.Issuer</dd></div>
              <div><dt>Fingerprint</dt><dd><code>@Model.Certificate.Thumbprint</code></dd></div>
            </dl>
          </details>
        }
        else { <p>Certificate information is available on Linux installations.</p> }
        <details class="yrm-certificate-import"><summary class="button button-secondary">+ Import Certificate</summary>
        <form method="post" asp-page-handler="Certificate" asp-route-tab="security" asp-route-section="certificates" enctype="multipart/form-data">
          <div class="v1-grid"><label>Certificate (PEM)<input name="certificate" type="file" accept=".crt,.pem" required /></label>
            <label>Private key (PEM)<input name="privateKey" type="file" accept=".key,.pem" required /></label></div>
          <div class="v1-row"><button class="button button-primary" type="submit">Import &amp; Activate</button></div>
        </form>
        </details>
        @if (Model.Certificate.IsCustom)
        {
          <form method="post" asp-page-handler="RestoreCertificate" asp-route-tab="security" asp-route-section="certificates" data-confirm="Restore the original self-signed certificate?"><button class="button button-secondary">Restore Default Certificate</button></form>
        }

      </section>
      }
    }
    else if (activeTab == "appearance")
    {
      <div class="settings-section-heading"><h2>Appearance</h2><p>Customize your desktop without changing the shared login screen.</p></div>
      <section class="surface-card settings-simple-card settings-wallpaper-card">
        <div class="settings-row-top"><h3>Desktop Wallpaper</h3><span class="muted">Personal desktop</span></div>
        <img class="v1-wallpaper-preview" id="wallpaper-preview" src="@(Model.HasWallpaper ? "/wallpaper?v=" + Model.WallpaperVersion : Url.Content("~/images/default-wallpaper.svg"))" alt="Wallpaper preview" />
        <div class="v1-wallpaper-mode"><button type="button" class="mini-button" data-wallpaper-fit>Full image</button> · Toggle actual desktop crop</div>
        <div class="wallpaper-actions">
          <form method="post" asp-page-handler="Wallpaper" asp-route-tab="appearance" enctype="multipart/form-data" id="wallpaper-upload-form" class="wallpaper-upload-actions">
            <input type="file" name="wallpaper" id="wallpaper-select" class="fm-visually-hidden" accept="image/jpeg,image/png,image/webp" required/>
            <button type="button" class="button button-secondary wallpaper-choose" data-file-picker="wallpaper-select">Choose Image</button>
            <button id="wallpaper-apply" type="submit" class="button button-primary" disabled>Apply</button>
          </form>
          <form method="post" asp-page-handler="ClearWallpaper" asp-route-tab="appearance" class="wallpaper-reset-form">
            <button type="submit" class="button button-secondary">Restore Default</button>
          </form>
        </div>
        <p id="wallpaper-selection-name" class="muted wallpaper-helper">JPEG, PNG or WebP · Up to 8 MB</p>
        <p class="muted wallpaper-helper">The login background stays system-wide and does not expose your desktop wallpaper.</p>
      </section>
    }
    else if (activeTab == "about")
    {
      <div class="settings-section-heading"><h2>About &amp; Updates</h2><p>Version information and system updates.</p></div>
      <section class="surface-card settings-simple-card">
        <div class="yrm-about-identity"><img src="~/images/yrm-panel-mark.png" alt="YRM PANEL icon" width="54" height="54" /><div><p class="eyebrow">YRM PANEL</p><h3>@info.PanelVersion.Split('+')[0]</h3></div></div>
        <p class="muted">Linux server management · ASP.NET Core 10</p>
        <a class="settings-text-link" href="https://github.com/yuanruoming/yrm-panel" target="_blank" rel="noopener noreferrer">Source and releases ↗</a>
      </section>
      <section class="surface-card settings-simple-card settings-update-card">
        <div class="settings-row-top"><h3>System Update</h3><span class="tag">@Model.UpdateChannel channel</span></div>
        <div class="yrm-update-overview">
          <div><small>Installed version</small><strong>@info.PanelVersion.Split('+')[0]</strong></div>
          <div><small>Latest release</small><strong>@(Model.LastUpdateCheck?.Tag ?? "Not checked")</strong></div>
        </div>
        <div class="yrm-update-tracker" id="v1-update-progress" role="status" aria-live="polite">
          <div class="yrm-update-tracker-head"><strong id="yrm-update-phase">@(Model.UpdateStatus.State == "running" ? "Updating" : Model.LastUpdateCheck?.HasUpdate == true ? "Update Available" : Model.UpdateStatus.State == "failed" ? "Update Failed" : Model.LastUpdateCheck?.Available == true ? "Up to Date" : "Not Checked")</strong><span id="yrm-update-percent"></span></div>
          <div id="yrm-update-bar" class="yrm-update-bar" role="progressbar" aria-label="Update download progress" hidden><span id="yrm-update-bar-fill"></span></div>
          <p id="yrm-update-message" class="muted">@(Model.UpdateStatus.State == "running" ? "Updating YRM PANEL." : Model.LastUpdateCheck?.HasUpdate == true ? Model.LastUpdateCheck.Message : Model.LastUpdateCheck?.Available == true ? "Your installed build is up to date." : Model.UpdateStatus.Message)</p>
          <ol id="yrm-b9-update-stages" class="yrm-b9-update-stages" aria-label="Update stages" hidden>
            @foreach (var stage in new[] { "Checking", "Downloading", "Verifying", "Installing", "Restarting", "Completed" })
            { <li data-b9-update-stage="@stage">@stage</li> }
          </ol>
          <p id="yrm-b9-update-detail" class="muted" hidden></p>
          <p id="yrm-update-time" class="yrm-update-time muted"></p>
          <button type="button" id="yrm-update-reload" class="button button-primary" hidden>Reload Panel</button>
        </div>

        <a class="settings-text-link" href="https://github.com/yuanruoming/yrm-panel/releases" target="_blank" rel="noopener noreferrer">View release notes ↗</a>
        @if (!string.IsNullOrWhiteSpace(Model.Notice)) { <p class="muted">@Model.Notice</p> }
        <div class="settings-button-row">
          <form method="post" asp-page-handler="CheckUpdate" asp-route-tab="about"><button class="button button-secondary" type="submit">Check Updates</button></form>
          @if (OperatingSystem.IsLinux())
          {
            @if (Model.UpdateStatus.State == "running")
            { <button class="button button-primary" disabled type="button">Updating...</button> }
            else if (Model.LastUpdateCheck?.HasUpdate == true)
            { <form method="post" asp-page-handler="Update" asp-route-tab="about" data-requires-admin="Install the latest YRM Panel release"><button class="button button-primary" data-v1-update type="submit">Update Now</button></form> }
            else { <button class="button button-primary" disabled type="button" title="Check for updates first">Update Now</button> }
          }
        </div>

      </section>
    }
  </div>
</div>
